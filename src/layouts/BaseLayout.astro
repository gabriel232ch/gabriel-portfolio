---
import '../styles/global.css';
import '../styles/interactions.css';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  lang?: string;
}

const {
  title,
  description = 'Gabriel Chen — work, research, writing, and evolving ideas.',
  noindex = true,
  lang = 'en',
} = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <title>{title}</title>
    <script is:inline>
      (() => {
        let stored, userQuiet = false;
        try { stored = localStorage.getItem('theme'); userQuiet = localStorage.getItem('quiet-motion') === 'true'; } catch {}
        const dark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        const quiet = userQuiet || window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        document.documentElement.dataset.theme = stored === 'light' || stored === 'dark' ? stored : dark ? 'dark' : 'light';
        document.documentElement.dataset.userQuiet = String(userQuiet);
        document.documentElement.dataset.quiet = String(quiet);
        document.documentElement.dataset.signature = quiet ? 'complete' : 'animate';
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <slot />
  </body>
</html>
