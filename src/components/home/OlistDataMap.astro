---
const tables = [
  {
    id: 'orders',
    label: 'orders',
    side: 'center' as const,
    x: 260,
    y: 98,
    role: 'Central purchase grain — links purchase, approval, estimated delivery, and actual delivery timestamps.',
    core: true,
  },
  {
    id: 'customers',
    label: 'customers',
    side: 'left' as const,
    x: 72,
    y: 36,
    role: 'Customer state & geography — anchors the state-level on-time decomposition and RJ/SP/MG market cohorts.',
    core: false,
  },
  {
    id: 'order_items',
    label: 'order_items',
    side: 'left' as const,
    x: 72,
    y: 98,
    role: 'Item prices (excluding freight) & seller links — defines delivered GMV proxy and multi-seller order bridges.',
    core: false,
  },
  {
    id: 'products',
    label: 'products',
    side: 'left' as const,
    x: 72,
    y: 160,
    role: 'Product categories — maps items into category × customer-state screening markets.',
    core: false,
  },
  {
    id: 'sellers',
    label: 'sellers',
    side: 'right' as const,
    x: 448,
    y: 36,
    role: 'Seller origin states — defines seller-state → customer-state route intersections such as SP → RJ.',
    core: false,
  },
  {
    id: 'payments',
    label: 'payments',
    side: 'right' as const,
    x: 448,
    y: 98,
    role: 'Payment records — cross-checked for order completeness alongside item-level merchandise value.',
    core: false,
  },
  {
    id: 'reviews',
    label: 'reviews',
    side: 'right' as const,
    x: 448,
    y: 160,
    role: 'One selected review per order — comparing answer vs. delivery timestamps revealed 97.39% before-receipt feedback in 8+ day delays.',
    core: false,
  },
];

const connectorPath = (t: (typeof tables)[number]) => {
  if (t.side === 'left') {
    return `M 212 98 C 176 98, 168 ${t.y}, ${t.x + 58} ${t.y}`;
  }
  return `M 308 98 C 344 98, 352 ${t.y}, ${t.x - 58} ${t.y}`;
};
---

<figure
  class="olist-data-map"
  data-olist-data-map
  aria-label="Olist data connects orders with customers, order items, products, sellers, payments, and reviews"
>
  <div class="olist-data-map__head">
    <span class="data-copy">RELATIONAL SCHEMA / 7 TABLES</span>
    <span class="data-copy">SELECT A TABLE</span>
  </div>

  {/* Clean Linear / Stripe Architecture Diagram */}
  <svg class="olist-data-map__constellation" viewBox="0 0 520 196" role="img" aria-label="Relational schema diagram of seven Olist tables centered on orders">
    <g class="olist-data-map__connections">
      {tables.filter((t) => !t.core).map((t) => (
        <path
          class="olist-data-map__edge"
          data-map-edge={t.id}
          data-active="true"
          d={connectorPath(t)}
        />
      ))}
    </g>

    {tables.filter((t) => !t.core).map((t) => (
      <g
        class="olist-data-map__pill-node"
        data-map-node={t.id}
        data-active="false"
      >
        <rect
          class="olist-data-map__pill"
          x={t.x - 58}
          y={t.y - 16}
          width="116"
          height="32"
          rx="8"
        />
        <circle
          class="olist-data-map__satellite"
          cx={t.side === 'left' ? t.x + 58 : t.x - 58}
          cy={t.y}
          r="3"
        />
        <text
          class="olist-data-map__node-text"
          x={t.x}
          y={t.y + 4}
          text-anchor="middle"
        >
          {t.label}
        </text>
      </g>
    ))}

    <g class="olist-data-map__hub" data-map-node="orders" data-active="true">
      <rect class="olist-data-map__core-card" x="212" y="76" width="96" height="44" rx="10" />
      <text class="olist-data-map__hub-text" x="260" y="102" text-anchor="middle">orders</text>
    </g>
  </svg>

  <div class="olist-data-map__controls anchor-tabs" role="group" aria-label="Inspect an Olist table">
    {tables.map((t) => (
      <button
        type="button"
        class="olist-data-map__chip"
        data-map-select={t.id}
        data-map-role={t.role}
        aria-pressed={t.core ? 'true' : 'false'}
      >
        {t.label}
      </button>
    ))}
  </div>
  <figcaption class="olist-data-map__readout" aria-live="polite" data-map-readout>
    <strong>orders</strong> — {tables[0].role}
  </figcaption>
</figure>

<script>
  document.querySelectorAll<HTMLElement>('[data-olist-data-map]').forEach((root) => {
    const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-map-select]')];
    const nodes = [...root.querySelectorAll<SVGGElement>('[data-map-node]')];
    const edges = [...root.querySelectorAll<SVGPathElement>('[data-map-edge]')];
    const readout = root.querySelector<HTMLElement>('[data-map-readout]');

    const activate = (id: string) => {
      const btn = buttons.find((b) => b.dataset.mapSelect === id);
      if (!btn) return;
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      nodes.forEach((n) => {
        n.dataset.active = String(n.dataset.mapNode === id);
      });
      edges.forEach((e) => {
        e.dataset.active = String(id === 'orders' || e.dataset.mapEdge === id);
      });
      if (readout) {
        readout.innerHTML = '';
        const strong = document.createElement('strong');
        strong.textContent = id;
        readout.append(strong, ` — ${btn.dataset.mapRole ?? ''}`);
      }
    };

    buttons.forEach((btn) => {
      const id = btn.dataset.mapSelect ?? 'orders';
      btn.addEventListener('click', () => activate(id));
    });

    nodes.forEach((node) => {
      const id = node.dataset.mapNode ?? 'orders';
      node.addEventListener('click', () => activate(id));
      node.addEventListener('pointerenter', () => activate(id));
    });
  });
</script>
