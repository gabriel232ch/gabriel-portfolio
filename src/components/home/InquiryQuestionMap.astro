---
import { SMALLER_COMPANIES_INQUIRY as inquiry } from '../../data/smaller-companies-inquiry';
const nodes=[{id:'geo',label:'Visibility'},{id:'positioning',label:'Positioning'},{id:'reality',label:'Reality'},{id:'decision-support',label:'Decision support'},{id:'crossroads',label:'Design'}].map(n=>({...n,chapter:inquiry.chapters.find(c=>c.id===n.id)!}));
---
<figure class="question-map">
  <figcaption class="data-copy">SELECTED TURNS IN THE INQUIRY</figcaption>
  <ol>{nodes.map((node,i)=><li><a href={`${'/work/why-some-people-choose-smaller-companies/'}#${node.id}`}><span class="question-map__index">{String(i+1).padStart(2,'0')}</span><span class="question-map__label">{node.label}</span><span class="question-map__question">{node.chapter.questionBefore}</span><span class="question-map__arrow" aria-hidden="true">↗</span></a></li>)}</ol>
  <p class="visual-note">A question kept changing as the evidence accumulated. Selected stages; the full inquiry includes intermediate steps.</p>
</figure>
