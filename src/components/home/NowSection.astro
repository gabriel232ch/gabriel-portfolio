---
import type { HOME_STATE } from '../../data/home';

interface Props {
  now: typeof HOME_STATE.now;
}

const { now } = Astro.props;
const trip = now.personalTrip;
const dateFormat = new Intl.DateTimeFormat('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});
const tripDates = dateFormat.formatRange(new Date(trip.startDate), new Date(trip.endDate));
---

<section id="about" class="home-now editorial-grid" aria-labelledby="now-title">
  <div class="home-now__heading">
    <h2 id="now-title" class="display">Now</h2>
  </div>

  <div class="home-now__trip" aria-labelledby="hong-kong-title">
    <div class="home-now__trip-heading">
      <h3 id="hong-kong-title">{trip.place}</h3>
      <p>{tripDates}</p>
    </div>
    <div class="home-now__photos">
      {trip.photos.map((photo) => (
        <figure class="home-now__photo" data-personal-snapshot>
          <img
            src={photo.src}
            width={photo.width}
            height={photo.height}
            alt={photo.alt}
            loading="lazy"
            decoding="async"
          />
          <figcaption>
            <span>{photo.caption}</span>
            <a href={photo.originalSrc} download aria-label={`Download original photo: ${photo.caption}`}>Download original</a>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>

  <div class="home-now__items">
    {now.items.map((item) => (
      <article class="home-now__item motion-reveal" data-home-motion data-now-item={item.id}>
        <p class="data-copy">{item.label}</p>
        <p class="editorial">{item.value}</p>
      </article>
    ))}
  </div>

</section>
