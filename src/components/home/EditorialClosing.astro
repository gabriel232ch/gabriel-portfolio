---
import SectionLabel from '../editorial/SectionLabel.astro';
import type { HomeArchiveItem } from '../../data/home';

interface Props {
  archive: HomeArchiveItem | null;
  sources: Array<{ label: string; href: string }>;
}

const { archive, sources } = Astro.props;
---

<section id="index" class="editorial-closing editorial-grid" aria-labelledby="closing-title">
  <div class="editorial-closing__label">
    <SectionLabel index="05" label="CLOSING / SOURCES" />
  </div>

  <div class="editorial-closing__main motion-reveal" data-home-motion>
    <h2 id="closing-title" class="display editorial-closing__title">Keep exploring</h2>

    <nav class="editorial-closing__coordinates" aria-label="Continue reading">
      <a href="#work">
        <span class="display">Selected work</span>
        <span class="data-copy">RETURN TO WORK</span>
      </a>
      {sources.map((source) => (
        <a data-closing-source href={source.href} target="_blank" rel="noreferrer">
          <span class="display">{source.label}</span>
          <span class="data-copy">PUBLIC SOURCE</span>
        </a>
      ))}
    </nav>
  </div>

  {archive && (
    <aside class="editorial-closing__archive motion-reveal" data-home-motion>
      <p class="data-copy">{archive.type} / {archive.date}</p>
      <h3>{archive.title}</h3>
      {archive.note && <p class="body-copy">{archive.note}</p>}
    </aside>
  )}

  <div class="editorial-closing__notation data-copy">
    <span>GABRIEL CHEN</span>
    <span>gabrielchen.me</span>
  </div>
</section>
