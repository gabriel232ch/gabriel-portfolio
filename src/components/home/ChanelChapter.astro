---
import { HOME_STATE } from '../../data/home';
import ChanelRecoveryPortrait from './ChanelRecoveryPortrait.astro';

interface Props {
  copy: (typeof HOME_STATE.projects)['chanel'];
}

const { copy } = Astro.props;
---

<section
  id="work"
  class="chanel-chapter editorial-grid"
  aria-labelledby="chanel-title"
  data-home-chapter="chanel"
  data-work-slug="luxury-handbag-pricing-architecture"
>
  <div class="chanel-chapter__opening">
    <p class="data-copy">{copy.context}</p>
    <h2 id="chanel-title" class="display">{copy.title}</h2>
    <p class="body-copy">{copy.opening}</p>
    <div class="chanel-chapter__return"><span class="data-copy chanel-chapter__turn-label">THE QUESTION RETURNED</span><p class="body-copy">{copy.return}</p></div>
  </div>

  <div class="chanel-chapter__place" data-photo-placement="milan">
    <figure class="chanel-chapter__campus">
      <img
        src={HOME_STATE.photography.campus.src}
        width={HOME_STATE.photography.campus.width}
        height={HOME_STATE.photography.campus.height}
        alt={HOME_STATE.photography.campus.alt}
        loading="lazy"
        decoding="async"
      />
      <figcaption>{HOME_STATE.photography.campus.caption}</figcaption>
    </figure>
    <figure class="chanel-chapter__milan">
      <img
        src={HOME_STATE.photography.milan.src}
        width={HOME_STATE.photography.milan.width}
        height={HOME_STATE.photography.milan.height}
        alt={HOME_STATE.photography.milan.alt}
        loading="lazy"
        decoding="async"
      />
      <figcaption>{HOME_STATE.photography.milan.caption}</figcaption>
    </figure>
  </div>

  <ChanelRecoveryPortrait />

  <div class="chanel-chapter__visible">
    <h3 class="editorial">{copy.resultsTitle}</h3>
    <p class="body-copy">{copy.results}</p>
  </div>

  <div class="chanel-chapter__turn motion-reveal" data-home-motion>
    <h3 class="display">{copy.recoveryTitle}</h3>
    <p class="body-copy">{copy.recovery}</p>
  </div>

  <div class="chanel-chapter__current motion-reveal" data-home-motion>
    <h3 class="editorial">{copy.explanationsTitle}</h3>
    <p class="body-copy">{copy.explanations}</p>
    <p class="body-copy">{copy.unresolved}</p>
    <p class="display chanel-chapter__status">{copy.status}</p>
    <a href={copy.href}>{copy.cta}</a>
  </div>
</section>
