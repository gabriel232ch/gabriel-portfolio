---
import { OLIST_DATA_METRICS } from '../../data/olist';
import OlistDataMap from './OlistDataMap.astro';

interface Props { copy: typeof import('../../data/home').HOME_STATE.projects.olist }
const { copy } = Astro.props;
const gmv = OLIST_DATA_METRICS.find((metric) => metric.id === 'gmv');
const onTime = OLIST_DATA_METRICS.find((metric) => metric.id === 'on-time');
if (!gmv || gmv.id !== 'gmv' || !onTime || onTime.id !== 'on-time') {
  throw new Error('Olist homepage requires GMV and on-time comparison metrics.');
}
---

<section
  id="olist"
  class="olist-chapter editorial-grid"
  aria-labelledby="olist-title"
  data-home-chapter="olist"
  data-work-slug="olist-marketplace-analysis"
>
  <div class="olist-chapter__intro">
    <p class="data-copy">{copy.context}</p>
    <h2 id="olist-title" class="display">{copy.title}</h2>
    <p class="body-copy">{copy.samsung}</p>
  </div>

  <div class="olist-chapter__progression">
    <p class="body-copy">{copy.learning}</p>
    <p class="display olist-chapter__highlight">{copy.highlight}</p>
    <p class="editorial statement olist-chapter__arrival">{copy.arrival}</p>
    <p class="body-copy">{copy.noQuestion}</p>
    <div class="olist-data-map-block" data-home-motion data-motion-sequence="olist-data-map">
      <div class="olist-data-map-block__tools">
        <button class="home-motion-replay" type="button" data-motion-replay aria-label="Replay animation">↻</button>
      </div>
      <OlistDataMap />
    </div>
  </div>

  <div class="olist-chapter__tension" data-olist-tension data-home-motion data-motion-sequence="olist-metrics">
    <div class="olist-chapter__tension-tools">
      <button class="home-motion-replay" type="button" data-motion-replay aria-label="Replay animation">↻</button>
    </div>
    <div>
      <span class="data-copy" data-motion-part="label" style="--motion-delay:90ms;">{gmv.label}</span>
      <span class="home-motion-number-mask" style="--motion-delay:155ms;">
        <button class="home-motion-kpi" type="button" data-motion-replay-number aria-label="Replay delivered GMV animation">
          <strong data-motion-part="number">{gmv.fromLabel} → {gmv.toLabel}</strong>
        </button>
      </span>
      <small data-motion-part="label" style="--motion-delay:260ms;">{gmv.context}</small>
      <small data-motion-part="label" style="--motion-delay:320ms;">{gmv.note}</small>
    </div>
    <div>
      <span class="data-copy" data-motion-part="label" style="--motion-delay:220ms;">{onTime.label}</span>
      <span class="home-motion-number-mask" style="--motion-delay:285ms;">
        <button class="home-motion-kpi" type="button" data-motion-replay-number aria-label="Replay on-time delivery animation">
          <strong data-motion-part="number">{onTime.fromLabel} → {onTime.toLabel}</strong>
        </button>
      </span>
      <small data-motion-part="label" style="--motion-delay:390ms;">{onTime.context}</small>
      <small data-motion-part="label" style="--motion-delay:450ms;">{onTime.note}</small>
    </div>
  </div>

  <blockquote class="olist-chapter__question">{copy.businessQuestion}</blockquote>

  <div class="olist-chapter__end">
    <p class="display">{copy.shift}</p>
    <p class="body-copy">{copy.reflection}</p>
    <a href={copy.href}>{copy.cta}</a>
  </div>
</section>
