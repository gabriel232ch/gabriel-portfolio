---
import { LUXURY_SLOWDOWN_CHANEL, LUXURY_SLOWDOWN_PEERS } from '../../data/luxury';

const baseline = LUXURY_SLOWDOWN_CHANEL[0];
const latest = LUXURY_SLOWDOWN_CHANEL[LUXURY_SLOWDOWN_CHANEL.length - 1];
const chanelGrowth = LUXURY_SLOWDOWN_PEERS[0];
const measures = [
  { label: 'Revenue', value: latest.revenue / baseline.revenue * 100 },
  { label: 'Operating profit', value: latest.operatingProfit / baseline.operatingProfit * 100 },
  { label: 'Free cash flow', value: latest.freeCashFlow / baseline.freeCashFlow * 100 },
];
---

<div class="chanel-business-signal" data-chanel-business data-home-motion>
  <p class="chanel-question editorial">Growth returned after a decline.</p>
  <div class="chanel-business-signal__baseline">
    <span><small>FY2024 comparable revenue growth</small><strong>{chanelGrowth.fy2024}</strong></span>
    <span><small>FY2025 comparable revenue growth</small><strong>{chanelGrowth.fy2025}</strong></span>
  </div>
  <p class="data-copy chanel-business-signal__basis">FY2025 as a share of FY2023 · reported USD · Chanel group</p>
  <div class="chanel-business-signal__shock">
    {measures.map((measure) => (
      <span><small>{measure.label}</small><strong>{measure.value.toFixed(1)}%</strong></span>
    ))}
  </div>
  <p class="body-copy chanel-business-signal__note">Revenue was closest to its earlier level. Profit and cash generation still had larger gaps. <a href="/work/luxury-handbag-pricing-architecture/#performance">Results and sources →</a></p>
</div>
