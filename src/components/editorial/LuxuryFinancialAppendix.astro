                  <tr><th>FY</th><th>Revenue</th><th>Revenue Growth / Basis</th><th>Operating Profit</th><th>Operating Margin*</th><th>FCF</th><th>Capex / Revenue</th><th>Brand-Support / Revenue</th></tr>
                </thead>
                <tbody>
                  {financialRows.map((row) => (
                    <tr>{row.map((cell, index) => index === 0 ? <th scope="row">{cell}</th> : <td>{cell}</td>)}</tr>
                  ))}
                </tbody>
              </table>
            </div>
          </details>
