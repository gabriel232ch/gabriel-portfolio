---
interface Series { label: string; values: number[]; actual: number[]; unit: string; precision: number }
interface Props { id: string; eyebrow: string; title: string; years: number[]; series: Series[]; maximum: number; ticks: number[]; kind: 'finance' | 'price'; note: string }
const { id, eyebrow, title, years, series, maximum, ticks, kind, note } = Astro.props;
const selected = years.length - 1;
const xStart = 52;
const xEnd = 594;
const x = (i: number) => xStart + ((years[i] - years[0]) / (years[selected] - years[0])) * (xEnd - xStart);
const y = (v: number) => 242 - (v / maximum) * 202;
const formatted = (s: Series, i: number) =>
  s.unit +
  s.actual[i].toLocaleString('en-US', { minimumFractionDigits: s.precision, maximumFractionDigits: s.precision }) +
  (kind === 'finance' ? 'm' : '');
const endTag = (s: Series) =>
  kind === 'finance'
    ? s.values[selected].toFixed(1)
    : s.unit + s.actual[selected].toLocaleString('en-US', { maximumFractionDigits: 0 });
const record = (i: number) => ({
  year: years[i],
  x: x(i),
  metrics: series.map((s) => ({
    label: s.label,
    value: formatted(s, i),
    index: s.values[i].toFixed(1),
    position: y(s.values[i]),
  })),
});

// Gap ribbon between highest (index 0) and lowest (last index) series
const topSeries = series[0];
const bottomSeries = series[series.length - 1];
const gapPolygon =
  series.length > 1
    ? [
        ...topSeries.values.map((v, i) => `${x(i)},${y(v)}`),
        ...bottomSeries.values
          .map((v, i) => `${x(i)},${y(v)}`)
          .reverse(),
      ].join(' ')
    : '';

// Non-overlapping full-column hover bands across the plot
const columnBands = years.map((_, i) => {
  const cx = x(i);
  const left = i === 0 ? xStart - 20 : (x(i - 1) + cx) / 2;
  const right = i === years.length - 1 ? xEnd + 24 : (cx + x(i + 1)) / 2;
  return { index: i, x: left, width: right - left };
});

// Prevent end-of-line label collisions when two endpoints sit close vertically
const endLabelOffsets = series.map((_, si) => {
  if (kind === 'finance' && si === 1) return -7;
  if (kind === 'finance' && si === 2) return 11;
  return 4;
});
---
<figure
  class:list={['chanel-viz', 'chanel-trajectory', { 'chanel-viz--price': kind === 'price' }]}
  data-chanel-reveal
  data-chanel-trajectory
  data-records={JSON.stringify(years.map((_, i) => record(i)))}
>
  <figcaption class="chanel-viz__caption">
    <span class="data-copy">{eyebrow}</span>
    <span class="data-copy">{kind === 'finance' ? 'FY2023 = 100 · REPORTED USD' : 'FRANCE · EUR · OBSERVED YEARS'}</span>
  </figcaption>
  <div class="chanel-viz__header">
    <div class="chanel-viz__title">
      <h3>{title}</h3>
      <span class="chanel-viz__edition" aria-hidden="true">{kind === 'finance' ? '01' : '03'}</span>
    </div>
    <div class="chanel-viz__legend anchor-tabs" aria-label="Highlight a series">
      <button type="button" data-trajectory-series="all" aria-pressed="true">All</button>
      {series.map((s, i) => (
        <button type="button" style={`--series-color:var(--chanel-series-${i})`} data-trajectory-series={i} aria-pressed="false">
          <i aria-hidden="true"></i>
          <span>{s.label}</span>
        </button>
      ))}
    </div>
  </div>

  <div class="chanel-trajectory__stage">
    <svg
      class="chanel-trajectory__plot"
      data-trajectory-plot
      viewBox="0 0 680 286"
      role="img"
      aria-labelledby={`${id}-title ${id}-description`}
    >
      <title id={`${id}-title`}>{title}</title>
      <desc id={`${id}-description`}>{note} Select an observed year below for exact values. Connecting lines join observations; they do not add measurements between years.</desc>
      <defs>
        <pattern id={`${id}-hatch`} width="8" height="8" patternUnits="userSpaceOnUse" patternTransform="rotate(-38)">
          <line x1="0" y1="0" x2="0" y2="8" stroke="var(--chanel-series-0)" stroke-opacity="0.13" stroke-width="1.2" />
        </pattern>
        <linearGradient id={`${id}-ribbon`} x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="var(--chanel-series-0)" stop-opacity="0.14" />
          <stop offset="100%" stop-color="var(--chanel-series-2)" stop-opacity="0.03" />
        </linearGradient>
      </defs>

      {ticks.map((t) => (
        <g class="chanel-viz__grid">
          <line x1={xStart} x2={xEnd} y1={y(t)} y2={y(t)} class={t === 0 ? 'chanel-viz__axis-zero' : undefined} />
          <text x={xStart - 12} y={y(t) + 3.5} text-anchor="end">
            {kind === 'price' ? (t === 0 ? '€0' : `€${t / 1000}k`) : t}
          </text>
        </g>
      ))}
      {kind === 'finance' && <line class="chanel-trajectory__baseline" x1={xStart} x2={xEnd} y1={y(100)} y2={y(100)} />}

      {gapPolygon && (
        <g class="chanel-trajectory__gap" aria-hidden="true">
          <polygon points={gapPolygon} fill={`url(#${id}-ribbon)`} />
          <polygon points={gapPolygon} fill={`url(#${id}-hatch)`} />
        </g>
      )}

      <line class="chanel-trajectory__guide" data-trajectory-guide x1={x(selected)} x2={x(selected)} y1="26" y2="244" />

      {series.map((s, si) => (
        <g class="chanel-trajectory__series" data-trajectory-line={si} style={`--series-color:var(--chanel-series-${si})`}>
          <path
            class="chanel-trajectory__line"
            pathLength="1"
            d={s.values.map((v, i) => `${i ? 'L' : 'M'}${x(i)},${y(v)}`).join(' ')}
          />
          {s.values.map((v, i) => (
            <circle class="chanel-trajectory__point" cx={x(i)} cy={y(v)} r="4" />
          ))}
          <circle class="chanel-trajectory__halo" data-trajectory-halo={si} cx={x(selected)} cy={y(s.values[selected])} r="12" />
          <circle class="chanel-trajectory__focus" data-trajectory-focus={si} cx={x(selected)} cy={y(s.values[selected])} r="5.5" />
          <text
            class="chanel-trajectory__end-tag"
            x={xEnd + 14}
            y={y(s.values[selected]) + endLabelOffsets[si]}
          >
            {endTag(s)}
          </text>
        </g>
      ))}

      {years.map((year, i) => (
        <text class="chanel-trajectory__year" x={x(i)} y="272" text-anchor="middle">
          {kind === 'finance' ? 'FY' : ''}{year}
        </text>
      ))}

      {/* Top-layer full-column hit zones prevent cursor oscillation over moving focus dots */}
      <g class="chanel-trajectory__zones" aria-hidden="true">
        {columnBands.map((band) => (
          <rect
            class="chanel-trajectory__zone"
            data-trajectory-observation={band.index}
            x={band.x}
            y="20"
            width={band.width}
            height="234"
          />
        ))}
      </g>
    </svg>
  </div>

  <div class="chanel-viz__toolbar">
    <span class="data-copy">OBSERVATION · HOVER CHART OR SELECT YEAR</span>
    <div class="chanel-viz__segments anchor-tabs" aria-label="Select observed year">
      {years.map((year, i) => (
        <button type="button" data-trajectory-year={i} aria-pressed={i === selected ? 'true' : 'false'}>
          {kind === 'finance' ? 'FY' : ''}{year}
        </button>
      ))}
    </div>
  </div>

  <div class="chanel-trajectory__readout" aria-live="polite" aria-atomic="true">
    <p class="data-copy" data-trajectory-label>{kind === 'finance' ? 'FY' : ''}{years[selected]}</p>
    <div class="chanel-trajectory__metrics">
      {series.map((s, i) => (
        <div style={`--series-color:var(--chanel-series-${i})`}>
          <span>{s.label}</span>
          <strong data-trajectory-value={i}>{formatted(s, selected)}</strong>
          {kind === 'finance' && (
            <small>
              <b data-trajectory-index={i}>{s.values[selected].toFixed(1)}</b> / FY2023 = 100
            </small>
          )}
        </div>
      ))}
    </div>
  </div>
  <p class="chanel-viz__note">{note}</p>
</figure>
