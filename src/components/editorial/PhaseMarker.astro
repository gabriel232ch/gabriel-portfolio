---
interface Props {
  id: string;
  label?: string;
}

const { id, label } = Astro.props;
---

<span class="phase-marker data-copy">
  <span>{id}</span>
  {label && <span class="phase-marker__label">{label}</span>}
</span>

<style>
  .phase-marker {
    display: inline-flex;
    gap: 0.75rem;
    align-items: baseline;
    font-size: 0.68rem;
  }

  .phase-marker__label {
    color: var(--ink-muted);
  }
</style>
