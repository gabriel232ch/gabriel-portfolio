---
interface Series {
  label: string;
  values: number[];
  counts: number[];
}
interface Props {
  id: string;
  title: string;
  series: Series[];
  minimum?: number;
  maximum?: number;
  note: string;
}

const { id, title, series, minimum = 0, maximum = 100, note } = Astro.props;
const months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug'];
const x = (index: number) => 48 + index * 82;
const y = (value: number) => 196 - ((value - minimum) / (maximum - minimum)) * 168;
const ticks = minimum === 75 ? [75, 85, 95, 100] : maximum === 25 ? [0, 10, 20, 25] : [0, 50, 100];
const valueLabel = (value: number) => `${value.toFixed(2)}%`;
const isComparison = series.length === 2;
const initialMonth = 0;

const readout = (index: number) =>
  `${months[index]} · ${series.map((s) => `${s.label}: ${valueLabel(s.values[index])} (n=${s.counts[index].toLocaleString('en-US')})`).join(' · ')}`;

const records = months.map((month, i) => {
  const diff = isComparison ? series[1].values[i] - series[0].values[i] : null;
  return {
    month,
    x: x(i),
    readout: readout(i),
    deltaText: diff === null ? '' : `${diff >= 0 ? '+' : '−'}${Math.abs(diff).toFixed(2)} pp YoY`,
    isNegativeDelta: diff !== null && (maximum === 25 ? diff > 0 : diff < 0),
    series: series.map((s) => ({
      val: valueLabel(s.values[i]),
      n: `n=${s.counts[i].toLocaleString('en-US')}`,
      y: y(s.values[i]),
    })),
  };
});

// Direct end-label anti-collision offset when 2 series finish close together
const endOffsets = series.map((_, si) => {
  if (!isComparison) return 4;
  const dy = Math.abs(y(series[0].values[7]) - y(series[1].values[7]));
  if (dy < 16) {
    const isUpper = y(series[si].values[7]) <= y(series[1 - si].values[7]);
    return isUpper ? -6 : 12;
  }
  return 4;
});
---
<figure
  class="olist-chart"
  data-olist-reveal
  data-line-chart
  data-chart-records={JSON.stringify(records)}
  data-chart-rows={JSON.stringify(months.map((_, i) => readout(i)))}
>
  <figcaption class="olist-chart__header">
    <div>
      <span class="olist-eyebrow">PURCHASE COHORTS / JAN–AUG</span>
      <h3>{title}</h3>
    </div>
    <div class="olist-chart__month-pill data-copy" data-chart-month-badge>{months[initialMonth]}</div>
  </figcaption>

  {/* DeepMind / Stripe live KPI callout strip */}
  <div class:list={['olist-chart__kpis', { 'olist-chart__kpis--single': !isComparison }]}>
    {series.map((s, si) => (
      <div class:list={['olist-chart__kpi', { 'olist-chart__kpi--second': si === 1 }]}>
        <span class="olist-chart__kpi-label">
          <i aria-hidden="true"></i>
          {s.label}
        </span>
        <div class="olist-chart__kpi-nums">
          <strong data-chart-series-val={si}>{valueLabel(s.values[initialMonth])}</strong>
          <small data-chart-series-n={si}>n={s.counts[initialMonth].toLocaleString('en-US')}</small>
        </div>
      </div>
    ))}
    {isComparison && (
      <div class="olist-chart__kpi olist-chart__kpi--delta">
        <span class="olist-chart__kpi-label">2018 vs 2017</span>
        <strong
          class:list={['olist-chart__delta-val', { 'is-negative': records[initialMonth].isNegativeDelta }]}
          data-chart-delta
        >
          {records[initialMonth].deltaText}
        </strong>
      </div>
    )}
  </div>

  {/* FT / NYT Zero-Clutter Continuous Trend SVG */}
  <svg viewBox="0 0 720 228" role="img" aria-labelledby={`${id}-title ${id}-desc`} data-chart-svg>
    <title id={`${id}-title`}>{title}</title>
    <desc id={`${id}-desc`}>{note} Exact values are available in the data table below.</desc>

    {isComparison && (
      <g class="olist-chart__window" aria-hidden="true">
        <rect x={x(1) - 24} y="22" width={x(2) - x(1) + 48} height="174" rx="6" />
        <text x={(x(1) + x(2)) / 2} y="16" text-anchor="middle">FEB–MAR DIP</text>
      </g>
    )}

    {ticks.map((tick) => (
      <g>
        <line x1="48" x2={x(7) + 8} y1={y(tick)} y2={y(tick)} class="olist-chart__grid" />
        <text x="38" y={y(tick) + 4} text-anchor="end">{tick}%</text>
      </g>
    ))}

    {months.map((month, i) => (
      <text x={x(i)} y="218" text-anchor="middle" class="olist-chart__month-text" data-chart-x-label={i} data-selected={i === initialMonth ? 'true' : 'false'}>
        {month}
      </text>
    ))}

    <line class="olist-chart__guide" x1={x(initialMonth)} x2={x(initialMonth)} y1="22" y2="198" data-chart-guide />

    {series.map((s, si) => (
      <g class:list={['olist-chart__series', { 'olist-chart__series--second': si === 1 }]}>
        <path class="olist-chart__line" d={s.values.map((v, i) => `${i ? 'L' : 'M'}${x(i)},${y(v)}`).join(' ')} />
        <circle
          class="olist-chart__focus"
          cx={x(initialMonth)}
          cy={y(s.values[initialMonth])}
          r="5"
          data-chart-focus={si}
        />
        <text class="olist-chart__end-label" x={x(7) + 16} y={y(s.values[7]) + endOffsets[si]}>
          {s.label} · {s.values[7].toFixed(1)}%
        </text>
      </g>
    ))}

    {/* Full-column invisible hover strips prevent node oscillation */}
    <g aria-hidden="true">
      {months.map((_, i) => (
        <rect
          class="olist-chart__column-hit"
          x={x(i) - 41}
          y="18"
          width="82"
          height="188"
          data-chart-month={i}
        />
      ))}
    </g>
  </svg>

  <div class="olist-chart__ticks anchor-tabs" role="group" aria-label="Jump to purchase month">
    {months.map((month, i) => (
      <button type="button" class="olist-chart__tick" data-chart-tick={i} aria-pressed={i === initialMonth ? 'true' : 'false'}>
        {month}
      </button>
    ))}
  </div>

  <div class="olist-chart__explore">
    <label for={`${id}-month`}>Month</label>
    <input id={`${id}-month`} class="editorial-slider" type="range" min="0" max="7" value={initialMonth} step="1" aria-valuetext={months[initialMonth]} data-chart-range />
  </div>

  <p class="olist-chart__readout" aria-live="polite" data-chart-readout>{readout(initialMonth)}</p>
  <p class="olist-chart__note">{note}</p>

  <details class="olist-data-details">
    <summary>Exact values and sample sizes</summary>
    <div class="olist-table-wrap scroll-fade-x" tabindex="0" role="region" aria-labelledby={`${id}-table-caption`}>
      <table>
        <caption id={`${id}-table-caption`}>{title}: monthly values</caption>
        <thead><tr><th>Month</th>{series.map((s) => <><th>{s.label}</th><th>Eligible n</th></>)}</tr></thead>
        <tbody>{months.map((m, i) => <tr><th scope="row">{m}</th>{series.map((s) => <><td>{valueLabel(s.values[i])}</td><td>{s.counts[i].toLocaleString('en-US')}</td></>)}</tr>)}</tbody>
      </table>
    </div>
  </details>
</figure>
