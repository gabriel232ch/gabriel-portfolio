---
interface Props {
  id: string;
  subtle?: boolean;
}

const { id, subtle = false } = Astro.props;
---

<span class:list={['g-index', 'data-copy', { 'g-index--subtle': subtle }]}>{id}</span>

<style>
  .g-index {
    font-size: 0.72rem;
  }

  .g-index--subtle {
    color: var(--ink-muted);
  }
</style>
