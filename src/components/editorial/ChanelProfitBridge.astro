---
const steps = [
  { label: 'FY2023', start: 0, end: 6407, change: 6407, kind: 'total', note: 'Starting operating profit: $6,407.0m.' },
  { label: 'Gross profit', start: 6407, end: 5634, change: -773, kind: 'loss', note: 'Gross profit decreased by $773.0m.' },
  { label: 'SG&A', start: 5634, end: 4649.2, change: -984.8, kind: 'loss', note: 'SG&A expense increased by $984.8m, reducing operating profit.' },
  { label: 'A&P / dist.', start: 4649.2, end: 4711.5, change: 62.3, kind: 'gain', note: 'A $62.3m decrease in advertising, promotion and distribution expense partly offset the decline.' },
  { label: 'FY2025', start: 0, end: 4711.5, change: 4711.5, kind: 'total', note: 'Ending operating profit: $4,711.5m; $1,695.5m below FY2023.' },
];
const y = (v: number) => 222 - (v / 7000) * 184;
const value = (v: number) =>
  (v < 0 ? '−' : '+') + '$' + Math.abs(v).toLocaleString('en-US', { minimumFractionDigits: 1, maximumFractionDigits: 1 }) + 'm';
---
<figure class="chanel-viz chanel-bridge" data-chanel-reveal>
  <figcaption class="chanel-viz__caption">
    <span class="data-copy">OPERATING PROFIT / ARITHMETIC BRIDGE</span>
    <span class="data-copy">USD MILLIONS · FY2023 → FY2025</span>
  </figcaption>
  <div class="chanel-viz__header chanel-viz__header--inline">
    <div class="chanel-viz__title-block">
      <h3>The earnings gap, step by step</h3>
      <span class="chanel-kpi-card__badge is-negative">−$1,695.5m · −26.5%</span>
    </div>
    <div class="chanel-bridge__steps anchor-tabs" aria-label="Explore profit bridge">
      <button type="button" data-bridge-all aria-pressed="true">All</button>
      {steps.map((s) => (
        <button type="button" data-bridge-step data-readout={s.note} aria-pressed="false">{s.label}</button>
      ))}
    </div>
  </div>
  <div class="chanel-bridge__plot scroll-fade-x" tabindex="0" role="region" aria-label="Operating profit bridge, scroll horizontally on small screens">
    <svg viewBox="0 0 680 258" role="img" aria-label="Operating profit falls from 6407 million dollars to 4711.5 million dollars: gross profit minus 773, SG&A minus 984.8, advertising promotion and distribution savings plus 62.3.">
      <line x1="28" x2="652" y1={y(0)} y2={y(0)} class="chanel-viz__axis-zero" />
      {steps.map((s, i) => {
        const barTop = y(Math.max(s.start, s.end));
        const barHeight = Math.max(6, Math.abs(y(s.start) - y(s.end)));
        const cx = 92 + i * 124;
        return (
          <g
            class:list={['chanel-bridge__step', `chanel-bridge__step--${s.kind}`]}
            data-bridge-bar={i}
            style={`--step-delay:${i * 90}ms`}
          >
            <rect
              class="chanel-bridge__bar"
              x={cx - 36}
              y={barTop}
              width="72"
              height={barHeight}
              rx="6"
            />
            <text
              class:list={['chanel-bridge__val', `chanel-bridge__val--${s.kind}`]}
              x={cx}
              y={barTop - 10}
              text-anchor="middle"
            >
              {s.kind === 'total' ? `$${s.end.toLocaleString('en-US', { minimumFractionDigits: 1 })}m` : value(s.change)}
            </text>
            <text class="chanel-bridge__label" x={cx} y="246" text-anchor="middle">{s.label}</text>
            {i < 4 && (
              <line class="chanel-bridge__connector" x1={cx + 36} x2={cx + 88} y1={y(s.end)} y2={y(s.end)} />
            )}
            <rect class="chanel-bridge__hit" x={cx - 60} y="16" width="120" height="234" fill="transparent" aria-hidden="true" />
          </g>
        );
      })}
    </svg>
  </div>
  <p class="chanel-recovery__readout" data-bridge-readout aria-live="polite">{steps[4].note}</p>
  <p class="chanel-viz__note">An accounting reconciliation, not a causal explanation of purchases. Capital expenditure is not an operating-expense step.</p>
</figure>
