---
import { getCollection } from 'astro:content';
import '@fontsource-variable/newsreader/wght.css';
import HomeHero from '../components/home/HomeHero.astro';
import HomeNavigation from '../components/home/HomeNavigation.astro';
import LuxuryFeature from '../components/home/LuxuryFeature.astro';
import OlistFeature from '../components/home/OlistFeature.astro';
import CompetitiveFeature from '../components/home/CompetitiveFeature.astro';
import { HOME_STATE, HOME_WORK_SLUGS } from '../data/home';
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/home.css';

const featuredWork = (await getCollection('work')).filter((entry) =>
  HOME_WORK_SLUGS.includes(entry.id as (typeof HOME_WORK_SLUGS)[number]),
);
const luxury = featuredWork.find((entry) => entry.id === HOME_WORK_SLUGS[0]);
const olist = featuredWork.find((entry) => entry.id === HOME_WORK_SLUGS[1]);
const competitive = featuredWork.find((entry) => entry.id === HOME_WORK_SLUGS[2]);

if (!luxury) {
  throw new Error('Luxury Handbag Pricing Architecture Home entry is missing.');
}

if (!olist) {
  throw new Error('Olist Marketplace Analysis Home entry is missing.');
}

if (!competitive) {
  throw new Error('Competitive Positioning Against Giants Home entry is missing.');
}
---

<BaseLayout title="Gabriel Chen">
  <main>
    <HomeNavigation />
    <HomeHero state={HOME_STATE} />
    <LuxuryFeature entry={luxury} />
    <OlistFeature entry={olist} />
    <CompetitiveFeature entry={competitive} />
  </main>
</BaseLayout>
