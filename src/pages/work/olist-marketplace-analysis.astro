---
import ReadingContents from '../../components/research/ReadingContents.astro';
import SiteHeader from '../../components/system/SiteHeader.astro';
import ResearchFooter from '../../components/research/ResearchFooter.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { OLIST_TRAIL } from '../../data/olist-trail';
import { HOME_STATE } from '../../data/home';
import { OLIST_DATA_METRICS, OLIST_DATA_SOURCES } from '../../data/olist';
import '../../styles/report.css';

const project = HOME_STATE.projects.olist;
---

<BaseLayout
  title={`${project.title} — Gabriel Chen`}
  description="An evidence-led Olist marketplace analysis about growth, fulfillment reliability, and the questions that connect them."
  noindex={false}
>
  <main id="main-content" tabindex="-1" class="research-page">
    <SiteHeader researchId="olist" />

    <div class="reading-progress" aria-hidden="true"><span data-reading-progress></span></div>

    <article class="research-page__article">
      <p class="research-page__kicker">SAMSUNG · 2025 → OLIST · 2026</p>
      <h1>{project.title}</h1>
      <p class="research-page__lede">{project.noQuestion}</p>

    <ReadingContents sections={[{'id': 'analysis-trail-title', 'label': 'Analysis trail'}, {'id': 'evidence-title', 'label': 'Findings'}, {'id': 'limits-title', 'label': 'Limits'}]} />
      <div data-reading-article>
      <section aria-labelledby="analysis-trail-title">
        <h2 id="analysis-trail-title">Analysis trail</h2>
        <ol class="analysis-trail">
          {OLIST_TRAIL.map((step)=><li data-analysis-step id={`trail-${step.id}`}>
            <h3>{step.question}</h3>
            <p><strong>Why this mattered</strong> — {step.rationale}</p>
            <p><strong>Observation</strong> — {step.observation}</p>
            <details><summary>Method and source</summary>
              <p><strong>Method</strong> — {step.method}</p>
              <a href={step.source} target="_blank" rel="noreferrer">Inspect the source →</a>
            </details>
          </li>)}
        </ol>
      </section>

      <section aria-labelledby="evidence-title">
        <h2 id="evidence-title">What the current analysis found</h2>
        <div class="research-page__evidence">
          {OLIST_DATA_METRICS.map((metric) => (
            <article class="research-page__evidence-card">
              <p class="research-page__eyebrow">{metric.label}</p>
              {metric.id === 'fix' ? (
                <>
                  <p class="research-page__metric">{metric.segments} material markets</p>
                  <p>{metric.orders} · {metric.gmvExposure} · {metric.lateOrders}</p>
                </>
              ) : (
                <>
                  <p class="research-page__metric">{metric.fromLabel} → {metric.toLabel}</p>
                  <p>{metric.context}</p>
                </>
              )}
              <p class="research-page__note">{metric.note}</p>
            </article>
          ))}
        </div>
      </section>

      <section aria-labelledby="limits-title">
        <h2 id="limits-title">What the data cannot tell me</h2>
        <p>
          The dataset does not provide commission revenue, complete costs or margins, marketing exposure, seller acquisition cost,
          inventory availability, carrier identity, complete refunds, or experiment assignment. The analysis is observational and does
          not establish causal impact.
        </p>
      </section>

      </div>
      <footer class="research-page__footer">
        <a href={OLIST_DATA_SOURCES.readme} target="_blank" rel="noreferrer">Source analysis on GitHub</a>
      </footer>
    </article>
    <ResearchFooter current="olist" />
  </main>
</BaseLayout>

<style>
  .research-page {
    min-height: 100vh;
    padding: 1.5rem clamp(1.25rem, 4vw, 5rem) 6rem;
    color: var(--ink);
    background: var(--paper);
    font-family: var(--font-reading);
  }

  .research-page__header,
  .research-page__footer {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: baseline;
    max-width: 74rem;
    margin: 0 auto;
  }

  .research-page__identity,
  .research-page__back,
  .research-page__footer a {
    color: inherit;
    font-family: var(--font-metadata);
    font-size: var(--font-size-micro);
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .research-page__article {
    max-width: 54rem;
    margin: 10rem auto 0;
  }

  .research-page .research-page__kicker,
  .research-page .research-page__eyebrow,
  .research-page .research-page__note {
    color: var(--ink-muted);
    font-family: var(--font-metadata);
    font-size: var(--font-size-micro);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .research-page h1,
  .research-page h2 {
    font-family: var(--font-display);
    font-weight: 400;
    letter-spacing: -0.035em;
  }

  .research-page h1 {
    max-width: 15ch;
    margin: 1.5rem 0;
    font-size: var(--font-size-project-title);
    line-height: 0.95;
  }

  .research-page h2 {
    margin: 0.5rem 0 1.5rem;
    font-size: var(--font-size-section-title);
    line-height: 1;
  }

  .research-page :where(p, li) {
    max-width: 42rem;
    font-family: var(--font-reading);
    font-size: var(--font-size-body);
    line-height: var(--line-height-reading);
  }

  .research-page .research-page__lede {
    max-width: 38rem;
    margin: 0 0 8rem;
    font-family: var(--font-display);
    font-size: var(--font-size-lead);
    line-height: 1.25;
  }

  .research-page section {
    margin: 0 0 8rem;
    padding-top: 2rem;
    border-top: 1px solid color-mix(in srgb, currentColor 22%, transparent);
  }

  .research-page__trail {
    display: grid;
    gap: 0.85rem;
    padding-left: 1.5rem;
  }

  .research-page__evidence {
    display: grid;
    gap: 1rem;
  }

  .research-page__evidence-card {
    padding: 1.25rem 0;
    border-top: 1px solid color-mix(in srgb, currentColor 16%, transparent);
  }

  .research-page__evidence-card p {
    margin: 0.25rem 0;
  }

  .research-page .research-page__metric {
    font-family: var(--font-numeric);
    font-size: var(--font-size-statement);
    font-feature-settings: 'lnum' 1, 'pnum' 1;
    font-variant-numeric: lining-nums proportional-nums;
    font-weight: 400;
    letter-spacing: -0.035em;
    line-height: 1.05;
  }

  .research-page .research-page__note {
    font-family: var(--font-metadata);
    font-size: var(--font-size-micro);
    line-height: 1.4;
  }

  .research-page__footer {
    justify-content: flex-start;
    padding-top: 2rem;
    border-top: 1px solid color-mix(in srgb, currentColor 22%, transparent);
  }

  @media (max-width: 640px) {
    .research-page__header {
      align-items: flex-start;
    }

    .research-page__article {
      margin-top: 6rem;
    }

    .research-page__lede,
    .research-page section {
      margin-bottom: 5rem;
    }
  }
</style>
