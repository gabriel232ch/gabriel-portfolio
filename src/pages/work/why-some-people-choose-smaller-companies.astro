---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  PUBLIC_RESEARCH_ARCHIVE_URL,
  SMALLER_COMPANIES_INQUIRY,
} from '../../data/smaller-companies-inquiry';
import '../../styles/work-inquiry.css';

type Chapter = (typeof SMALLER_COMPANIES_INQUIRY.chapters)[number];
type Transition = (typeof SMALLER_COMPANIES_INQUIRY.transitions)[number];
type SystemizationNode = (typeof SMALLER_COMPANIES_INQUIRY.systemizationNodes)[number];
type InquiryStage =
  | { type: 'chapter'; id: string; chapter: Chapter }
  | { type: 'transition'; id: string; transition: Transition }
  | { type: 'systemization'; id: string; node: SystemizationNode };

const inquiry = SMALLER_COMPANIES_INQUIRY;
const stages: InquiryStage[] = inquiry.chapters.flatMap((chapter) => {
  const afterChapter: InquiryStage[] = [{ type: 'chapter', id: chapter.id, chapter }];

  inquiry.transitions
    .filter((transition) => transition.afterChapterId === chapter.id)
    .forEach((transition) => {
      afterChapter.push({
        type: 'transition',
        id: transition.id,
        transition,
      });
    });

  inquiry.systemizationNodes
    .filter((node) => node.afterChapterId === chapter.id)
    .forEach((node) => {
      afterChapter.push({
        type: 'systemization',
        id: node.id,
        node,
      });
    });

  return afterChapter;
});
---

<BaseLayout
  title={`${inquiry.title} — Gabriel Chen`}
  description={inquiry.dek}
  noindex={false}
>
  <main class="inquiry-page">
    <header class="inquiry-page__header">
      <a class="inquiry-page__identity" href="/">GABRIEL CHEN</a>
      <a class="inquiry-page__back" href="/#work">← BACK TO WORK</a>
    </header>

    <article class="inquiry-page__article">
      <header class="inquiry-page__hero">
        <p class="inquiry-page__kicker">AN OPEN INQUIRY · FIELD NOTES</p>
        <h1>{inquiry.title}</h1>
        <p class="inquiry-page__dek">{inquiry.dek}</p>
        <p class="inquiry-page__opening">{inquiry.opening}</p>

        <nav class="inquiry-page__contents" aria-label="On this page">
          <details>
            <summary class="data-copy">On this page</summary>
            <ol>
              {inquiry.chapters.map((chapter) => (
                <li>
                  <a href={'#' + chapter.id}>{chapter.heading}</a>
                </li>
              ))}
            </ol>
          </details>
        </nav>
      </header>

      <div class="inquiry-page__story">
        {stages.map((stage) => (
          <div class="inquiry-page__stage" data-inquiry-stage={stage.id}>
            {stage.type === 'chapter' ? (
              <section
                id={stage.chapter.id}
                class="inquiry-page__chapter"
                aria-labelledby={'chapter-' + stage.chapter.id + '-title'}
              >
                <header class="inquiry-page__section-header">
                  <p class="inquiry-page__stage-label data-copy">Question {String(inquiry.chapters.indexOf(stage.chapter) + 1).padStart(2, '0')}</p>
                  <h2 id={'chapter-' + stage.chapter.id + '-title'}>{stage.chapter.heading}</h2>
                </header>

                <p class="inquiry-page__question-label data-copy">The question I was asking</p>
                <blockquote class="inquiry-page__question">
                  <p>{stage.chapter.questionBefore}</p>
                </blockquote>

                <p class="inquiry-page__evidence-label data-copy">What I found</p>
                <p class="inquiry-page__evidence body-copy">{stage.chapter.evidenceOrProblem}</p>

                <div class="inquiry-page__body">
                  {stage.chapter.body.map((paragraph) => <p class="body-copy">{paragraph}</p>)}
                </div>

                <div class="inquiry-page__reframe">
                  <span class="data-copy">How the question changed</span>
                  <p class="body-copy">{stage.chapter.reframe}</p>
                </div>

                {stage.chapter.id === 'evaluation' && (
                  <aside
                    class="inquiry-page__findings"
                    aria-labelledby="evaluation-findings-title"
                  >
                    <h3 id="evaluation-findings-title">What the later matrix recorded</h3>
                    <ol>
                      {inquiry.evaluation.findings.map((finding, index) => (
                        <li>
                          <p class="inquiry-page__finding-observation">{finding.observation}</p>
                          <p class="inquiry-page__finding-scope data-copy">Scope: {finding.scope}</p>
                          <a
                            class="inquiry-page__finding-method data-copy"
                            href={finding.archiveHref}
                            target="_blank"
                            rel="noreferrer"
                            aria-label={`Method details for finding ${index + 1}`}
                          >
                            Method details <span aria-hidden="true">↗</span>
                          </a>
                        </li>
                      ))}
                    </ol>
                  </aside>
                )}

                {stage.chapter.id === 'decision-support' && (
                  <aside class="inquiry-page__synthesis" aria-labelledby="inquiry-synthesis-title">
                    <h3 id="inquiry-synthesis-title">A working interpretation</h3>
                    <p class="body-copy">{inquiry.currentSynthesis}</p>
                  </aside>
                )}

                {stage.chapter.id === 'crossroads' && (
                  <aside class="inquiry-page__design-status" aria-labelledby="inquiry-design-title">
                    <h3 id="inquiry-design-title">Prototype status</h3>
                    <p class="body-copy">{inquiry.currentDesign}</p>
                  </aside>
                )}

                {stage.chapter.archiveHref && (
                  <a
                    class="inquiry-page__archive-link data-copy"
                    href={stage.chapter.archiveHref}
                    target="_blank"
                    rel="noreferrer"
                  >
                    Explore the research <span aria-hidden="true">↗</span>
                  </a>
                )}
              </section>
            ) : stage.type === 'transition' ? (
              <aside
                id={stage.transition.id}
                class="inquiry-page__transition"
                aria-labelledby={stage.transition.id + '-title'}
              >
                <p class="inquiry-page__stage-label data-copy">An intermediate step</p>
                <h3 id={stage.transition.id + '-title'}>{stage.transition.heading}</h3>
                {stage.transition.body.map((paragraph) => <p class="body-copy">{paragraph}</p>)}
              </aside>
            ) : (
              <aside
                id={stage.node.id}
                class="inquiry-page__systemization"
                data-systemization-node
                aria-labelledby={stage.node.id + '-title'}
              >
                <p class="inquiry-page__stage-label data-copy">When the process began to repeat</p>
                <h3 id={stage.node.id + '-title'}>{stage.node.heading}</h3>
                <div class="inquiry-page__body">
                  {stage.node.body.map((paragraph) => <p class="body-copy">{paragraph}</p>)}
                </div>
                <a
                  class="inquiry-page__archive-link data-copy"
                  href={stage.node.archiveHref}
                  target="_blank"
                  rel="noreferrer"
                >
                  Explore the method <span aria-hidden="true">↗</span>
                </a>
              </aside>
            )}
          </div>
        ))}
      </div>

      <footer class="inquiry-page__footer">
        <p class="inquiry-page__status">{inquiry.closing}</p>
        <a
          class="inquiry-page__archive-link data-copy"
          href={PUBLIC_RESEARCH_ARCHIVE_URL}
          target="_blank"
          rel="noreferrer"
        >
          Open the public research archive <span aria-hidden="true">↗</span>
        </a>
      </footer>
    </article>
  </main>
</BaseLayout>
