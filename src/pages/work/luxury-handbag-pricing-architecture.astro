---
import FolioNumber from '../../components/editorial/FolioNumber.astro';
import SectionLabel from '../../components/editorial/SectionLabel.astro';
import ThemeToggle from '../../components/system/ThemeToggle.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { LUXURY_FLAGSHIP, LUXURY_FLAGSHIP_SOURCES } from '../../data/luxury';
import '../../styles/report.css';

const architectureTiers = [
  {
    tier: 'Entry / Lower',
    france: '< €3,000',
    unitedStates: '< $4,000',
    role: 'No numeric observation in the current Chanel snapshot',
  },
  {
    tier: 'Core',
    france: '€3,000–€4,999',
    unitedStates: '$4,000–$5,999',
    role: 'Lower end of Mini Classic and selected Shopping Bags',
  },
  {
    tier: 'Premium',
    france: '€5,000–€9,999',
    unitedStates: '$6,000–$10,999',
    role: 'Shopping / Bowling and higher core offerings',
  },
  {
    tier: 'Icon / Exceptional',
    france: '≥ €10,000',
    unitedStates: '≥ $11,000',
    role: 'Classic 11.12, Small Classic, and higher-priced variants',
  },
];

const historicalRows = [
  ['2022', '€8,720', '€4,250', '2.052×', '€4,470'],
  ['2023', '€9,500', '€4,600', '2.065×', '€4,900'],
  ['2024', '€10,100', '€4,850', '2.082×', '€5,250'],
  ['2026', '€10,300', '€4,950', '2.081×', '€5,350'],
];

const financialRows = [
  ['2020', '10,108', '-18.0%', '2,018', '20.0%', '679', '10.7%', '13.5%'],
  ['2021', '15,639', '+49.6%', '5,461', '34.9%', '4,540', '4.8%', '11.5%'],
  ['2022', '17,200', '+17.0%', '5,776', '33.6%', '3,534', '3.9%', '11.9%'],
  ['2023', '19,700', '+16.0%', '6,407', '32.5%', '3,755', '6.2%', '12.5%'],
  ['2024', '18,699', '-4.3%', '4,479', '24.0%', '1,842', '9.4%', '13.1%'],
  ['2025', '19,269', '+1.8% comparable / +3.0% reported', '4,712', '24.5%', '2,646', '7.5%', '12.4%'],
];

const financialDashboardRows = [
  { year: '2020', revenue: 10108, growth: -18, profit: 2018, margin: 20, fcf: 679 },
  { year: '2021', revenue: 15639, growth: 49.6, profit: 5461, margin: 34.9, fcf: 4540 },
  { year: '2022', revenue: 17200, growth: 17, profit: 5776, margin: 33.6, fcf: 3534 },
  { year: '2023', revenue: 19700, growth: 16, profit: 6407, margin: 32.5, fcf: 3755 },
  { year: '2024', revenue: 18699, growth: -4.3, profit: 4479, margin: 24, fcf: 1842 },
  { year: '2025', revenue: 19269, growth: 3, profit: 4712, margin: 24.5, fcf: 2646 },
];

const hermesRows = [
  ['2020', '6,389.4', '31.0%', '3,209.2', '-4.8%', '50.2%'],
  ['2021', '8,982', '39.3%', '4,091', '+29.0%', '45.5%'],
  ['2022', '11,602', '40.5%', '4,963', '+15.6%', '42.8%'],
  ['2023', '13,427', '42.1%', '5,547', '+16.7%', '41.3%'],
  ['2024', '15,170', '40.5%', '6,457', '+18.3%', '42.6%'],
  ['2025', '16,002', '41.0%', '7,070', '+13.1%', '44.2%'],
];

const hermesDashboardRows = [
  { year: '2020', group: 6389.4, leather: 3209.2, margin: 31, growth: -4.8, share: 50.2 },
  { year: '2021', group: 8982, leather: 4091, margin: 39.3, growth: 29, share: 45.5 },
  { year: '2022', group: 11602, leather: 4963, margin: 40.5, growth: 15.6, share: 42.8 },
  { year: '2023', group: 13427, leather: 5547, margin: 42.1, growth: 16.7, share: 41.3 },
  { year: '2024', group: 15170, leather: 6457, margin: 40.5, growth: 18.3, share: 42.6 },
  { year: '2025', group: 16002, leather: 7070, margin: 41, growth: 13.1, share: 44.2 },
];

const financial2025 = financialDashboardRows[financialDashboardRows.length - 1];
const hermes2025 = hermesDashboardRows[hermesDashboardRows.length - 1];
const hermesMarginMin = 30;
const hermesMarginMax = 45;

const lvmhRows = [
  ['2020', '21,207', '-5%', '-3%', '7,188', '33.9%'],
  ['2021', '30,896', '+46%', '+47%', '12,842', '41.6%'],
  ['2022', '38,648', '+25%', '+20%', '15,709', '40.6%'],
  ['2023', '42,169', '+9%', '+14%', '16,836', '39.9%'],
  ['2024', '41,060', '-3%', '-1%', '15,230', '37.1%'],
  ['2025', '37,770', '-8%', '-5%', '13,209', '35.0%'],
];

const lvmhDashboardRows = [
  { year: '2020', revenue: 21207, reported: -5, organic: -3, profit: 7188, margin: 33.9 },
  { year: '2021', revenue: 30896, reported: 46, organic: 47, profit: 12842, margin: 41.6 },
  { year: '2022', revenue: 38648, reported: 25, organic: 20, profit: 15709, margin: 40.6 },
  { year: '2023', revenue: 42169, reported: 9, organic: 14, profit: 16836, margin: 39.9 },
  { year: '2024', revenue: 41060, reported: -3, organic: -1, profit: 15230, margin: 37.1 },
  { year: '2025', revenue: 37770, reported: -8, organic: -5, profit: 13209, margin: 35.0 },
];

const lvmh2025 = lvmhDashboardRows.at(-1)!;
const lvmhMarginMin = 30;
const lvmhMarginMax = 45;

const judgments = [
  {
    title: 'Price Evidence Supports Premiumization',
    lead: 'Yes, within the price evidence.',
    body: 'The current architecture shows a high visible entry/core floor and a clear Classic/icon anchor. The aligned historical panel shows both access/core and icon lines moving higher, with a wider absolute gap and a broadly stable relative ratio. This conclusion comes from prices, not revenue.',
  },
  {
    title: 'Premiumization and Business Performance Coexisted, Unevenly',
    lead: 'They coexisted, but the pattern was not stable across years.',
    body: 'Revenue, margin, and FCF were strong in 2021–2023, deteriorated in 2024, and recovered in 2025. The accurate statement is that premiumization coexisted with recovery and continued investment; the data does not establish a pricing-to-growth causal relationship.',
  },
  {
    title: 'The Architecture Held, but Demand Resilience Remains Unproven',
    lead: 'The structure persisted across the observed period; prices alone cannot show demand resilience.',
    body: 'The public snapshot does not show the price structure falling during the 2024 operating setback. That supports persistence of the architecture, while the 2024 margin and FCF pressure shows continued exposure to the cycle and reinvestment demands. Demand, volume/mix, conversion, and customer migration require customer and transaction data.',
  },
  {
    title: 'Chanel and Hermès Differ by Price Role',
    lead: 'Chanel combines a high visible floor, a strong Classic anchor, and a wide middle gap.',
    body: 'Hermès has a wider, more distributed upper ladder. Its Leather Goods & Saddlery business line and higher group-margin context make it useful for leather-goods momentum and margin comparison. Hermès is not simply the answer to “who is more expensive.”',
  },
  {
    title: 'Chanel and LVMH F&LG Followed Different Paths',
    lead: 'LVMH F&LG was strong in 2020–2023 and slowed in 2024–2025; Chanel reported a recovery in 2025.',
    body: 'Chanel’s performance cannot be assigned entirely to the industry cycle, nor treated as independent of it. The supported conclusion is narrower: the trajectories differ, and the difference is shaped by reporting level, brand mix, foreign exchange, and geographic exposure.',
  },
  {
    title: 'Premiumization Came with Continued Reinvestment',
    lead: 'Public financial materials show sustained capex and high brand-support investment.',
    body: 'The disclosed investment spans boutiques, client experience, craftsmanship, supplier capacity, and real estate. This supports an interpretation of premiumization as requiring reinvestment. It does not support treating brand-support investment as handbag marketing expense or proving that investment caused price or profit outcomes.',
  },
];

const tensions = [
  ['Exclusivity vs recruitment', 'A high visible entry threshold has limited overlap with lower-tier competitors.', 'Conversion and recruitment effects require customer-funnel and migration data.'],
  ['Icon monetization vs ladder continuity', 'The Classic anchor is strong; the pre-icon → icon gap is €3,300 / $3,600.', 'Whether the gap creates migration risk requires assortment, conversion, and client-movement data.'],
  ['Broad repricing vs competitive substitution', 'Multiple tiers moved higher, with different overlap against Dior, Louis Vuitton, and Hermès.', 'Actual substitution requires transaction, win/loss, or client data.'],
  ['Premiumization vs growth quality', 'Price architecture persisted in 2024 while revenue, margin, and FCF came under pressure.', 'Public data cannot separate volume/mix, regional, investment, and demand-elasticity effects.'],
  ['Price elevation vs reinvestment requirement', 'Brand support, capex, craftsmanship, boutique, and experience investment continued.', 'The causal return from investment to desirability, price realization, or profit is not identified.'],
];

const implications = [
  'Manage the ladder, not only the Classic anchor. The Classic position is clear, but the visible middle gap is now an architecture issue to monitor. Without behavioral evidence, it should not trigger a product or price change on its own.',
  'Monitor middle-ladder continuity. Track the entry → core → icon family steps, price visibility, and future assortment coverage. First establish whether a gap is a real portfolio issue or a limitation of the public sample.',
  'Benchmark competitors by tier and reporting level. Use Louis Vuitton and Dior for the lower/core battleground, Hermès Leather Goods & Saddlery for leather-goods context, and LVMH F&LG for the broader multi-brand environment. A single global price ranking would obscure these differences.',
  'Evaluate premiumization alongside growth quality and investment. Each pricing decision should be read with revenue growth, margin, FCF, capex, brand-support intensity, and regional commentary. Price is not a success metric by itself.',
  'Use customer and transaction data before intervening. Validate migration, conversion, volume/mix, stock availability, realized price, SKU economics, and willingness to pay before deciding whether to repair the middle of the ladder or change the entry architecture.',
];

const canJudge = [
  'The current public list-price architecture: tiers, family steps, SKU gaps, price visibility, and the Classic anchor.',
  'Broad repricing and gap evolution across selected 2020–2026 historical price paths.',
  'Trends in Chanel consolidated revenue, profit, margin, FCF, capex, and brand-support investment for FY2020–FY2025.',
  'Reporting-level-valid benchmark context from Hermès Leather Goods & Saddlery and LVMH Fashion & Leather Goods.',
  'Whether premiumization appeared alongside business performance and investment over time.',
];

const cannotJudge = [
  'Chanel handbag revenue, handbag units, handbag gross margin, Classic revenue, or SKU profitability.',
  'Customer conversion, demand elasticity, willingness to pay, realized price, volume/mix, migration, or substitution.',
  'Louis Vuitton standalone revenue or Dior standalone couture-brand revenue.',
  'Whether price changes caused revenue, profit, cash flow, or brand desirability outcomes.',
];

const architectureScale = (market: (typeof LUXURY_FLAGSHIP.architecture)[number]) =>
  Math.max(market.maximum * 1.05, market.maximum + 500);

const architecturePosition = (value: number, market: (typeof LUXURY_FLAGSHIP.architecture)[number]) =>
  `${(value / architectureScale(market)) * 100}%`;

const historicalChart = [
  { year: '2022', classic: 8720, access: 4250, gap: 4470 },
  { year: '2023', classic: 9500, access: 4600, gap: 4900 },
  { year: '2024', classic: 10100, access: 4850, gap: 5250 },
  { year: '2026', classic: 10300, access: 4950, gap: 5350 },
];

const businessChart = [
  { label: 'REVENUE', values: [10108, 15639, 17200, 19700, 18699, 19269], max: 20000, unit: '$m' },
  { label: 'OPERATING MARGIN', values: [20, 34.9, 33.6, 32.5, 24, 24.5], max: 40, unit: '%' },
  { label: 'FCF', values: [679, 4540, 3534, 3755, 1842, 2646], max: 5000, unit: '$m' },
];
---

<BaseLayout
  title="Chanel Premiumization Strategy — Gabriel Chen"
  description="A complete analysis of Chanel handbag price architecture, historical repricing, business performance and competitive positioning."
  noindex={false}
  lang="en"
>
  <main class="report-page">
    <header class="report-topline">
      <a class="report-topline__identity" href="/">
        <span>GABRIEL CHEN</span>
        <span class="data-copy">WORK / RESEARCH</span>
      </a>
      <div class="report-topline__tools">
        <a class="data-copy" href="/#work">← BACK TO WORK</a>
        <ThemeToggle />
      </div>
    </header>
    <div class="report-progress" aria-hidden="true">
      <span data-report-progress></span>
    </div>

    <section class="report-hero" aria-labelledby="report-title">
      <div class="report-hero__label">
        <SectionLabel index="01" label="RESEARCH / PRICING" />
        <FolioNumber current="01" />
      </div>
      <div class="report-hero__main">
        <p class="report-kicker editorial"><em>Chanel Handbag Pricing</em></p>
        <h1 id="report-title" class="report-title">Price Architecture, Business Performance, and Competitive Position</h1>
        <p class="report-lede">
          How does Chanel build and move its handbag price ladder? This report traces visible list prices, aligned historical lines, consolidated financial results, and comparable luxury-leather-goods context.
        </p>
        <p class="report-meta data-copy">
          PRICE WINDOW: 2020–2026 <span aria-hidden="true">/</span>
          CURRENT SNAPSHOT: {LUXURY_FLAGSHIP.snapshot.capturedAt} <span aria-hidden="true">/</span>
          FINANCIAL CORE: FY2020–FY2025
        </p>
      </div>
    </section>

    <div class="report-layout">
      <aside class="report-index" aria-label="Report contents">
        <p class="data-copy">ON THIS PAGE</p>
        <ol>
          <li><a href="#thesis">01 / Conclusion</a></li>
          <li><a href="#architecture">02 / Price architecture</a></li>
          <li><a href="#history">03 / Historical change</a></li>
          <li><a href="#business">04 / Business performance</a></li>
          <li><a href="#competition">05 / Competitive context</a></li>
          <li><a href="#judgments">06 / Six insights</a></li>
          <li><a href="#tensions">07 / Strategic tensions</a></li>
          <li><a href="#implications">08 / Implications</a></li>
          <li><a href="#boundaries">09 / Evidence boundaries</a></li>
          <li><a href="#sources">10 / Sources</a></li>
        </ol>
      </aside>

      <article class="report-body">
        <section id="thesis" class="report-section report-section--opening">
          <p class="report-section__number data-copy">01 / CONCLUSION</p>
          <h2>Conclusion</h2>
          <p class="report-claim">
            Chanel’s premiumization is a shift in the full price architecture, not only a higher Classic ticket.
          </p>
          <ul class="report-bullets">
            <li>The current sample shows a high visible entry/core floor, a concentrated premium zone, and a clear Classic/icon anchor.</li>
            <li>Aligned France lines from 2022–2026 show both Mini/access-core and Classic/icon prices moving higher. The Classic relationship held while the absolute gap widened.</li>
            <li>Over the same period, Chanel’s consolidated revenue recovery, operating margin, cash generation, and brand/capital investment coexisted with the price move.</li>
            <li>Revenue, operating profit, and FCF all came under pressure in 2024, then partly recovered in 2025. Price elevation is not a validated growth engine, and it does not remove cycle, regional-demand, or reinvestment risk.</li>
          </ul>
          <p>
            The supported interpretation is that premiumization depends on the price ladder, the Classic anchor, desirability, distribution and client experience, craftsmanship and supply, and cash and profit performance holding together. Public evidence shows these factors coexisting and reveals tensions between them; it does not establish that price changes caused the operating results.
          </p>
        </section>

        <section id="architecture" class="report-section">
          <p class="report-section__number data-copy">02 / PRICE ARCHITECTURE</p>
          <h2>How Chanel’s Handbag Price Architecture Works</h2>
          <p>
            The current snapshot contains 41 accepted observations, 35 with numeric prices: 17 of 20 in France and 18 of 21 in the United States. Folded into the existing market bands, the sample forms four analytical tiers:
          </p>
          <div class="report-table-wrap">
            <table>
              <thead>
                <tr><th>Analytical Tier</th><th>France / EUR</th><th>United States / USD</th><th>Chanel Observed Role</th></tr>
              </thead>
              <tbody>
                {architectureTiers.map((row) => (
                  <tr><th scope="row">{row.tier}</th><td>{row.france}</td><td>{row.unitedStates}</td><td>{row.role}</td></tr>
                ))}
              </tbody>
            </table>
          </div>
          <div class="report-visual report-visual--architecture" data-report-motion data-interactive-chart aria-label="Observed Chanel price endpoints in France and the United States">
            <div class="report-visual__heading">
              <span class="data-copy">FIG. 01 / OBSERVED PRICE ENDPOINTS</span>
              <span class="data-copy">HOVER / CLICK TO INSPECT</span>
            </div>
            <div class="report-price-lanes">
              {LUXURY_FLAGSHIP.architecture.map((market) => (
                <div class="report-price-lane">
                  <div class="report-price-lane__meta">
                    <strong>{market.name}</strong>
                    <span class="data-copy">{market.currency} / {LUXURY_FLAGSHIP.snapshot.capturedAt}</span>
                  </div>
                  <div class="report-price-lane__rail">
                    <span class="report-price-lane__line"></span>
                    <button type="button" class="report-price-lane__node report-price-lane__node--entry" data-chart-bar data-series="entry" data-market={market.name} aria-label={`${market.name} entry price: ${market.currency} ${market.minimum.toLocaleString('en-US')}`} aria-pressed="false" style={`--node-position:${architecturePosition(market.minimum, market)};`}>
                      <i></i><b>ENTRY</b><em>{market.currency === 'EUR' ? '€' : '$'}{market.minimum.toLocaleString('en-US')}</em>
                    </button>
                    <button type="button" class="report-price-lane__node report-price-lane__node--pre" data-chart-bar data-series="pre-icon" data-market={market.name} aria-label={`${market.name} pre-icon price: ${market.currency} ${market.preIcon.toLocaleString('en-US')}`} aria-pressed="false" style={`--node-position:${architecturePosition(market.preIcon, market)};`}>
                      <i></i><b>PRE-ICON</b><em>{market.currency === 'EUR' ? '€' : '$'}{market.preIcon.toLocaleString('en-US')}</em>
                    </button>
                    <button type="button" class="report-price-lane__node report-price-lane__node--icon" data-chart-bar data-series="icon" data-market={market.name} aria-label={`${market.name} icon price: ${market.currency} ${market.icon.toLocaleString('en-US')}`} aria-pressed="false" style={`--node-position:${architecturePosition(market.icon, market)};`}>
                      <i></i><b>ICON</b><em>{market.currency === 'EUR' ? '€' : '$'}{market.icon.toLocaleString('en-US')}</em>
                    </button>
                    <button type="button" class="report-price-lane__node report-price-lane__node--max" data-chart-bar data-series="max" data-market={market.name} aria-label={`${market.name} maximum price: ${market.currency} ${market.maximum.toLocaleString('en-US')}`} aria-pressed="false" style={`--node-position:${architecturePosition(market.maximum, market)};`}>
                      <i></i><b>MAX</b><em>{market.currency === 'EUR' ? '€' : '$'}{market.maximum.toLocaleString('en-US')}</em>
                    </button>
                  </div>
                  <p class="report-price-lane__note data-copy">{market.observationNote}</p>
                </div>
              ))}
            </div>
          </div>
          <p>
            In the current sample, Chanel’s observed numeric range is €4,850–€12,250 in France and $5,400–$13,500 in the United States. The largest visible pre-icon → icon gap is €6,700 → €10,000 in France, or €3,300; in the United States it is $7,400 → $11,000, or $3,600. The largest median family step is Bowling Bag → Small Classic: €4,100 in France and $4,600 in the United States.
          </p>
          <p>
            Numeric versus non-numeric visibility is 35 / 6. The six non-numeric Chanel rows are contact_us entries with no listed price. They remain visibility states rather than being interpolated into higher prices.
          </p>
          <p class="report-note">
            Figures 1–2 use observed numeric list prices across the four-brand range and Chanel’s ladder. A visible gap is not the same as a complete-assortment gap or a demand barrier.
          </p>
          <h3>Competition Is Tiered, Not One Global Ranking</h3>
          <p>
            The current four-brand panel contains 161 accepted observations, 147 with numeric prices. At the lower end, Chanel overlaps more with Louis Vuitton and Dior; its overlap with Hermès is concentrated higher up. A single “who is more expensive” ranking would hide this structure.
          </p>
          <p>
            Directional French cells support the same tiered reading. In tote | large | leather, the median is €6,200 for Chanel, €6,475 for Hermès, and €3,350 for Dior. In tote | standard | leather, it is €5,700 for Chanel, €3,400 for Dior, and €2,900 for Louis Vuitton. Some brand cells have only one or two observations, so they indicate position rather than like-for-like substitution or consumer share.
          </p>
          <p class="report-note">Figures 3–4 are analytical summaries of public list-price samples, not official brand strategy statements.</p>
        </section>

        <section id="history" class="report-section">
          <p class="report-section__number data-copy">03 / HISTORICAL CHANGE</p>
          <h2>How the Architecture Has Changed</h2>
          <p>
            The rerun historical panel tracks four selected continuous lines in Chanel France across the common years 2022, 2023, 2024, and 2026:
          </p>
          <details class="report-details">
            <summary><span class="data-copy">SHOW FULL DATA TABLE</span><span class="data-copy">4 YEARS / 4 SIGNALS</span></summary>
            <div class="report-table-wrap">
              <table>
                <thead>
                  <tr><th>FY / Observed Year</th><th>Classic / Icon Median</th><th>Mini / Access-Core Median</th><th>Relative Ratio</th><th>Absolute Gap</th></tr>
                </thead>
                <tbody>
                  {historicalRows.map((row) => (
                    <tr>{row.map((cell, index) => index === 0 ? <th scope="row">{cell}</th> : <td>{cell}</td>)}</tr>
                  ))}
                </tbody>
              </table>
            </div>
          </details>
          <div class="report-visual report-visual--history" data-report-motion data-interactive-chart aria-label="Classic and Mini median prices from 2022 to 2026">
            <div class="report-visual__heading">
              <span class="data-copy">FIG. 02 / ALIGNED FRANCE LINES</span>
              <span class="data-copy">HOVER / CLICK TO INSPECT</span>
            </div>
            <div class="report-history-chart">
              <div class="report-history-chart__axis data-copy"><span>€10k</span><span>€5k</span><span>€0</span></div>
              <div class="report-history-chart__plot">
                {historicalChart.map((row) => (
                  <div class="report-history-column">
                    <div class="report-history-column__bars">
                      <button type="button" class="report-history-bar report-history-bar--classic" data-chart-bar data-series="classic" data-year={row.year} aria-label={`Classic / Icon ${row.year}: €${row.classic.toLocaleString('en-US')}`} aria-pressed="false" style={`--bar-height:${(row.classic / 11000) * 100}%;`}><b>€{row.classic.toLocaleString('en-US')}</b></button>
                      <button type="button" class="report-history-bar report-history-bar--access" data-chart-bar data-series="access-core" data-year={row.year} aria-label={`Mini / Access-Core ${row.year}: €${row.access.toLocaleString('en-US')}`} aria-pressed="false" style={`--bar-height:${(row.access / 11000) * 100}%;`}><b>€{row.access.toLocaleString('en-US')}</b></button>
                    </div>
                    <span class="report-history-column__year data-copy">{row.year}</span>
                  </div>
                ))}
              </div>
            </div>
            <div class="report-history-chart__legend data-copy">
              <span><i class="report-swatch report-swatch--classic"></i>CLASSIC / ICON</span>
              <span><i class="report-swatch report-swatch--access"></i>MINI / ACCESS-CORE</span>
            </div>
          </div>
          <p>
            From 2022 to 2026, the Classic median rose 18.1% and the Mini/access-core median rose 16.5%. The ratio changed little, while the absolute gap widened by €880. The evidence supports broad repricing across multiple tiers, with some ladder stretching as the price base rose—not a Classic-only increase.
          </p>
          <p class="report-note">Figure 5 uses common observation years only. It is not the full Chanel handbag assortment or a U.S. historical price series.</p>
          <p>
            The square Mini rose approximately 44.8% over the longer 2020–2026 window. The main Mini-versus-Classic comparison uses the aligned 2022–2026 window to avoid different starting points. The historical panel contains 77 accepted observations, 76 numeric prices, and 13 lineages: seven same-model continuous lines and six successors. Missing years are not treated as zero change.
          </p>
        </section>

        <section id="business" class="report-section">
          <p class="report-section__number data-copy">04 / BUSINESS PERFORMANCE</p>
          <h2>What Happened to the Business While This Occurred</h2>
          <h3>Chanel Consolidated Company</h3>
          <p>
