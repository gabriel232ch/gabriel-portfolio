---
import FolioNumber from '../../components/editorial/FolioNumber.astro';
import SectionLabel from '../../components/editorial/SectionLabel.astro';
import ThemeToggle from '../../components/system/ThemeToggle.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  LUXURY_FLAGSHIP,
  LUXURY_FLAGSHIP_SOURCES,
  LUXURY_SLOWDOWN_CHANEL,
  LUXURY_SLOWDOWN_PEERS,
} from '../../data/luxury';
import '../../styles/report.css';

const architectureScale = (market: (typeof LUXURY_FLAGSHIP.architecture)[number]) =>
  Math.max(market.maximum * 1.05, market.maximum + 500);

const architecturePosition = (value: number, market: (typeof LUXURY_FLAGSHIP.architecture)[number]) =>
  (value / architectureScale(market)) * 100;

const historicalRows = [
  { year: '2022', classic: 8720, mini: 4250, ratio: '2.052×', gap: 4470 },
  { year: '2023', classic: 9500, mini: 4600, ratio: '2.065×', gap: 4900 },
  { year: '2024', classic: 10100, mini: 4850, ratio: '2.082×', gap: 5250 },
  { year: '2026', classic: 10300, mini: 4950, ratio: '2.081×', gap: 5350 },
];

const baseline = LUXURY_SLOWDOWN_CHANEL[0];
const slowdownRows = LUXURY_SLOWDOWN_CHANEL.map((row) => ({
  ...row,
  revenueIndex: (row.revenue / baseline.revenue) * 100,
  operatingProfitIndex: (row.operatingProfit / baseline.operatingProfit) * 100,
}));

const slowdownSeries = [
  { key: 'revenue', label: 'REVENUE INDEX', value: 'revenueIndex' as const },
  { key: 'profit', label: 'OPERATING PROFIT INDEX', value: 'operatingProfitIndex' as const },
];
---

<BaseLayout
  title="Chanel’s Price Ladder Under a Luxury Slowdown — Gabriel Chen"
  description="Chanel’s handbag price ladder moved higher, while FY2025 brought only a partial group-revenue recovery and operating profit remained well below FY2023."
  noindex={false}
  lang="en"
>
  <main class="report-page">
    <header class="report-topline">
      <a class="report-topline__identity" href="/">
        <span>GABRIEL CHEN</span>
        <span class="data-copy">WORK / RESEARCH</span>
      </a>
      <div class="report-topline__tools">
        <a class="data-copy" href="/#work">← BACK TO WORK</a>
        <ThemeToggle />
      </div>
    </header>
    <div class="report-progress" aria-hidden="true"><span data-report-progress></span></div>

    <section class="report-hero" aria-labelledby="report-title">
      <div class="report-hero__label">
        <SectionLabel index="01" label="RESEARCH / PRICING" />
        <FolioNumber current="01" />
      </div>
      <div class="report-hero__main">
        <p class="report-kicker editorial"><em>Chanel Handbag Pricing</em></p>
        <h1 id="report-title" class="report-title">Chanel’s Price Ladder Under a Luxury Slowdown</h1>
        <p class="report-lede">Higher handbag prices, a partial business recovery, and the limits of a resilience story.</p>
        <p class="report-hero__summary">
          This case connects Chanel’s visible handbag price architecture with its consolidated performance through the luxury slowdown. The price evidence covers France and the United States, with a current snapshot dated {LUXURY_FLAGSHIP.snapshot.capturedAt}. The diagnostic focuses on FY2023–FY2025; selected French price histories extend through 2026.
        </p>
        <p class="report-meta data-copy">
          PRICE SNAPSHOT: {LUXURY_FLAGSHIP.snapshot.capturedAt} <span aria-hidden="true">/</span>
          ALIGNED PRICE HISTORY: 2022–2026 <span aria-hidden="true">/</span>
          FINANCIAL DIAGNOSTIC: FY2023–FY2025
        </p>
      </div>
    </section>

    <div class="report-layout">
      <aside class="report-index" aria-label="Report contents">
        <p class="data-copy">ON THIS PAGE</p>
        <ol>
          <li><a href="#answer">01 / The answer</a></li>
          <li><a href="#architecture">02 / Price ladder</a></li>
          <li><a href="#slowdown">03 / The slowdown test</a></li>
          <li><a href="#recovery">04 / Where revenue returned</a></li>
          <li><a href="#profit">05 / The profit gap</a></li>
          <li><a href="#boundaries">06 / Evidence boundaries</a></li>
          <li><a href="#sources">07 / Sources</a></li>
        </ol>
      </aside>

      <article class="report-body">
        <section id="answer" class="report-section report-section--opening">
          <p class="report-section__number data-copy">01 / THE ANSWER</p>
          <h2>What the evidence says</h2>
          <p class="report-claim">
            Chanel moved its observed handbag price ladder higher while preserving a strong Classic anchor. Its business did not improve continuously alongside that move.
          </p>
          <p>
            Group revenue declined in FY2024 and partly recovered in FY2025, while operating profit remained well below FY2023. Chanel looked different from some contracting peers in FY2025, but that difference is narrower than immunity to the slowdown. Public disclosures locate the recovery by region and channel and reconcile the remaining profit gap. They do not establish that handbag pricing or marketing caused the recovery.
          </p>
          <p class="report-note">Price observations, consolidated company accounts, and peer growth disclosures describe different reporting levels. None is a proxy for Chanel handbag sales or customer demand.</p>
        </section>

        <section id="architecture" class="report-section">
          <p class="report-section__number data-copy">02 / PRICE ARCHITECTURE</p>
          <h2>A price ladder moved higher</h2>
          <p>
            The current Chanel sample contains 41 accepted observations, 35 with numeric prices: 17 of 20 in France and 18 of 21 in the United States. The endpoints below describe the public list-price sample captured on {LUXURY_FLAGSHIP.snapshot.capturedAt}.
          </p>

          <div class="report-visual report-visual--architecture" data-report-motion data-interactive-chart role="group" aria-label="Observed Chanel price endpoints in France and the United States">
            <div class="report-visual__heading">
              <span class="data-copy">FIG. 01 / OBSERVED PRICE ENDPOINTS</span>
              <span class="data-copy">HOVER OR SELECT A MARKER</span>
            </div>
            <div class="report-price-lanes">
              {LUXURY_FLAGSHIP.architecture.map((market) => (
                <div class="report-price-lane">
                  <div class="report-price-lane__meta">
                    <strong>{market.name}</strong>
                    <span class="data-copy">{market.currency} / {LUXURY_FLAGSHIP.snapshot.capturedAt}</span>
                  </div>
                  <div class="report-price-lane__rail">
                    <span class="report-price-lane__line"></span>
                    {[
                      { label: 'ENTRY', key: 'entry', classKey: 'entry', value: market.minimum },
                      { label: 'PRE-ICON', key: 'pre-icon', classKey: 'pre', value: market.preIcon },
                      { label: 'ICON', key: 'icon', classKey: 'icon', value: market.icon },
                      { label: 'MAX', key: 'max', classKey: 'max', value: market.maximum },
                    ].map((point) => (
                      <button
                        type="button"
                        class={'report-price-lane__node report-price-lane__node--' + (point.classKey ?? point.key)}
                        data-chart-bar
                        data-series={point.key}
                        data-market={market.name}
                        aria-label={market.name + ' ' + point.label.toLowerCase() + ' price: ' + market.currency + ' ' + point.value.toLocaleString('en-US')}
                        aria-pressed="false"
                        style={'--node-position:' + architecturePosition(point.value, market) + '%;'}
                      >
                        <i></i><b>{point.label}</b><em>{market.currency === 'EUR' ? '€' : '$'}{point.value.toLocaleString('en-US')}</em>
                      </button>
                    ))}
                  </div>
                  <p class="report-price-lane__note data-copy">{market.observationNote}</p>
                </div>
              ))}
            </div>
          </div>

          <p>
            The visible pre-icon-to-icon step is €6,700 to €10,000 in France (€3,300) and $7,400 to $11,000 in the United States ($3,600). Those are gaps in the observed list-price sample, not measured obstacles in a customer’s purchase journey. Six Chanel rows have no listed price and remain visibility states; they are not interpolated into higher prices.
          </p>
          <p class="report-note">
            The current four-brand panel contains 161 accepted observations, 147 with numeric prices. R1’s stricter like-for-like comparison threshold produced no publishable headline cells. Competitor prices therefore remain tiered context, not evidence of a brand advantage or customer substitution. The detailed source and threshold review is linked below.
          </p>

          <h3>Selected French price lines also moved</h3>
          <p>
            Across selected continuous France lines in the common observation years 2022, 2023, 2024, and 2026, the Classic median rose 18.1% and the Mini median rose 16.5%. Their relative ratio changed little; the absolute gap widened by €880. Broad repricing across these tiers describes the evidence better than a Classic-only increase.
          </p>
          <details class="report-details">
            <summary><span class="data-copy">SHOW ALIGNED PRICE OBSERVATIONS</span><span class="data-copy">4 YEARS / 4 SIGNALS</span></summary>
            <div class="report-table-wrap">
              <table>
                <thead><tr><th>Observed year</th><th>Classic / icon median</th><th>Mini / access-core median</th><th>Relative ratio</th><th>Absolute gap</th></tr></thead>
                <tbody>
                  {historicalRows.map((row) => (
                    <tr><th scope="row">{row.year}</th><td>€{row.classic.toLocaleString('en-US')}</td><td>€{row.mini.toLocaleString('en-US')}</td><td>{row.ratio}</td><td>€{row.gap.toLocaleString('en-US')}</td></tr>
                  ))}
                </tbody>
              </table>
            </div>
          </details>
          <div class="report-visual report-visual--history" data-report-motion data-interactive-chart role="group" aria-label="Selected Classic and Mini median prices in France from 2022 to 2026">
            <div class="report-visual__heading">
              <span class="data-copy">FIG. 02 / ALIGNED FRANCE LINES</span>
              <span class="data-copy">HOVER OR SELECT A BAR</span>
            </div>
            <div class="report-history-chart">
              <div class="report-history-chart__axis data-copy"><span>€10k</span><span>€5k</span><span>€0</span></div>
              <div class="report-history-chart__plot">
                {historicalRows.map((row) => (
                  <div class="report-history-column">
                    <div class="report-history-column__bars">
                      <button type="button" class="report-history-bar report-history-bar--classic" data-chart-bar data-series="classic" data-year={row.year} aria-label={'Classic / icon ' + row.year + ': €' + row.classic.toLocaleString('en-US')} aria-pressed="false" style={'--bar-height:' + (row.classic / 11000) * 100 + '%;'}><b>€{row.classic.toLocaleString('en-US')}</b></button>
                      <button type="button" class="report-history-bar report-history-bar--access" data-chart-bar data-series="mini" data-year={row.year} aria-label={'Mini / access-core ' + row.year + ': €' + row.mini.toLocaleString('en-US')} aria-pressed="false" style={'--bar-height:' + (row.mini / 11000) * 100 + '%;'}><b>€{row.mini.toLocaleString('en-US')}</b></button>
                    </div>
                    <span class="report-history-column__year data-copy">{row.year}</span>
                  </div>
                ))}
              </div>
            </div>
            <div class="report-history-chart__legend data-copy">
              <span><i class="report-swatch report-swatch--classic"></i>CLASSIC / ICON</span>
              <span><i class="report-swatch report-swatch--access"></i>MINI / ACCESS-CORE</span>
            </div>
          </div>
          <p class="report-note">Selected observed lines are not the full Chanel handbag assortment or a U.S. historical price series. Missing years are not treated as zero change.</p>
        </section>

        <section id="slowdown" class="report-section">
          <p class="report-section__number data-copy">03 / THE SLOWDOWN TEST</p>
          <h2>The slowdown changed the interpretation</h2>
          <p>
            Using FY2023 as the baseline separates the pandemic rebound from the following slowdown. Disclosed growth rates show different paths, but their definitions and reporting scopes are not identical:
          </p>
          <div class="report-table-wrap">
            <table class="report-table--wide">
              <thead><tr><th>Reporting entity</th><th>FY2024 growth</th><th>FY2025 growth</th><th>Disclosure basis</th></tr></thead>
              <tbody>
                {LUXURY_SLOWDOWN_PEERS.map((peer) => (
                  <tr><th scope="row">{peer.entity}</th><td>{peer.fy2024}</td><td>{peer.fy2025}</td><td>{peer.basis}</td></tr>
                ))}
              </tbody>
            </table>
          </div>
          <p class="report-note">These are each company’s disclosed growth measures, not a like-for-like ranking. Gucci is a brand; Chanel and Hermès are groups; LVMH Fashion &amp; Leather Goods is a multi-brand business segment.</p>
          <p>
            Chanel’s FY2024 comparable revenue declined 4.3%, then grew 1.8% in FY2025. In reported US dollars, FY2025 group revenue was about 97.6% of FY2023, while operating profit was only 73.5%. Revenue partly recovered; earnings did not return to their FY2023 level.
          </p>

          <div class="report-visual report-index-chart" data-report-motion data-interactive-chart role="group" aria-label="Chanel consolidated revenue and operating profit indexed to FY2023 equals 100">
            <div class="report-visual__heading">
              <span class="data-copy">FIG. 03 / CHANEL CONSOLIDATED RESULTS</span>
              <span class="data-copy">FY2023 = 100 / USD</span>
            </div>
            {slowdownSeries.map((series) => (
              <div class={'report-index-chart__row report-index-chart__row--' + series.key}>
                <strong class="data-copy">{series.label}</strong>
                <div class="report-index-chart__cells">
                  {slowdownRows.map((row) => {
                    const value = row[series.value];
                    return (
                      <div class="report-index-chart__cell">
                        <span class="data-copy">{row.year}</span>
                        <button type="button" class="report-index-chart__bar" data-chart-bar data-series={series.key} data-year={row.year} aria-label={series.label.toLowerCase() + ' ' + row.year + ' index: ' + value.toFixed(1)} aria-pressed="false">
                          <span class="report-index-chart__track"><i style={'--index-width:' + value + '%;'}></i></span>
                          <b>{value.toFixed(1)}</b>
                        </button>
                      </div>
                    );
                  })}
                </div>
              </div>
            ))}
          </div>
          <details class="report-details">
            <summary><span class="data-copy">SHOW REPORTED FINANCIAL VALUES</span><span class="data-copy">FY2023–FY2025 / USD MILLIONS</span></summary>
            <div class="report-table-wrap">
              <table>
                <thead><tr><th>Fiscal year</th><th>Net revenue</th><th>Revenue index</th><th>Operating profit</th><th>Operating-profit index</th></tr></thead>
                <tbody>
                  {slowdownRows.map((row) => (
                    <tr><th scope="row">{row.year}</th><td>${row.revenue.toLocaleString('en-US', { minimumFractionDigits: 1, maximumFractionDigits: 1 })}m</td><td>{row.revenueIndex.toFixed(1)}</td><td>${row.operatingProfit.toLocaleString('en-US', { minimumFractionDigits: 1, maximumFractionDigits: 1 })}m</td><td>{row.operatingProfitIndex.toFixed(1)}</td></tr>
                  ))}
                </tbody>
              </table>
            </div>
          </details>
          <p class="report-note">The indexed values are calculated from exact consolidated FY2023–FY2025 inputs. They are not growth disclosures; peer rates above retain each company’s reported, comparable, organic, or constant-currency basis.</p>
        </section>

        <section id="recovery" class="report-section">
          <p class="report-section__number data-copy">04 / WHERE REVENUE RETURNED</p>
          <h2>A partial recovery, with different regional and channel paths</h2>
          <p>
            The regional bridge locates the reported-dollar decline and recovery. Asia Pacific accounted for 90.4% of Chanel’s net revenue decline in FY2024. In FY2025, Europe and the Americas added revenue while Asia Pacific continued to decline.
            <a href={LUXURY_FLAGSHIP_SOURCES.slowdownRegionReview} target="_blank" rel="noreferrer">Regional analysis ↗</a>
          </p>
          <p>
            The channel bridge shows that both retail and wholesale recovered in FY2025, but retail regained only 45.7% of its prior-year loss. Region and channel are parallel breakdowns of group revenue, not additive contributions.
            <a href={LUXURY_FLAGSHIP_SOURCES.slowdownChannelReview} target="_blank" rel="noreferrer">Channel and product analysis ↗</a>
          </p>
          <div class="report-table-wrap">
            <table class="report-table--wide">
              <thead><tr><th>Disclosure cut</th><th>FY2024</th><th>FY2025</th><th>What the bridge cannot establish</th></tr></thead>
              <tbody>
                <tr><th scope="row">Region</th><td>Asia Pacific represented 90.4% of the net revenue decline</td><td>Europe and the Americas added revenue; Asia Pacific declined</td><td>Shopper nationality or product-category contribution</td></tr>
                <tr><th scope="row">Channel</th><td>Retail and wholesale declined</td><td>Both recovered; retail regained 45.7% of its prior-year loss</td><td>Retail is not handbag sales; wholesale is not beauty sales</td></tr>
              </tbody>
            </table>
          </div>
          <p class="report-note">The percentages describe disclosed group-level bridges. Neither is a handbag demand or customer-migration measure.</p>
        </section>

        <section id="profit" class="report-section">
          <p class="report-section__number data-copy">05 / THE PROFIT GAP</p>
          <h2>Why operating profit remained behind</h2>
          <p>
            Filed-account inputs reconcile a $1,695.5 million operating-profit shortfall between FY2023 and FY2025. Lower gross profit and higher SG&amp;A explain the arithmetic; the savings shown below partly offset the decline.
            <a href={LUXURY_FLAGSHIP_SOURCES.slowdownProfitReview} target="_blank" rel="noreferrer">Operating-profit bridge ↗</a>
          </p>
          <div class="report-table-wrap">
            <table>
              <thead><tr><th>Bridge item</th><th>Change</th><th>Interpretation</th></tr></thead>
              <tbody>
                <tr><th scope="row">Operating profit, FY2023</th><td>$6,407.0m</td><td>Consolidated-company starting point</td></tr>
                <tr><th scope="row">Gross profit</th><td>−$773.0m</td><td>Lower gross profit</td></tr>
                <tr><th scope="row">Selling, general and administrative expenses</th><td>+$984.8m expense</td><td>Higher SG&amp;A expense</td></tr>
                <tr><th scope="row">Advertising, promotion and distribution</th><td>−$62.3m expense</td><td>Savings partly offset the changes above</td></tr>
                <tr><th scope="row">Operating profit, FY2025</th><td>$4,711.5m</td><td>$1,695.5m below FY2023</td></tr>
              </tbody>
            </table>
          </div>
          <p>
            Continued investment does not identify its return. Capital expenditure cannot be assigned wholesale to operating expenses in the year it was paid, and this bridge does not isolate the demand or investment mechanism behind the profit gap.
          </p>
          <h3>Product and marketing evidence has a time boundary</h3>
          <p>
            The earlier marketing study covers 2025-08-13 to 2026-08-13. It helps describe how Chanel renewed its brand expression, but that period cannot explain FY2025 results. Matthieu Blazy’s first collection reached stores in March 2026, so those merchandise sales fall outside FY2025; any earlier halo effect remains unmeasured.
          </p>
          <p>
            Public accounts of CHANEL 25’s everyday use and third-party estimates of Chanel’s beauty scale are possible explanations for a broader business mix, not representative buyer evidence or measured category contribution. The evidence supports an inventory of plausible mechanisms, not a ranking of marketing effectiveness.
            <a href={LUXURY_FLAGSHIP_SOURCES.slowdownCustomerReview} target="_blank" rel="noreferrer">Customer and beauty evidence review ↗</a>
          </p>
        </section>

        <section id="boundaries" class="report-section">
          <p class="report-section__number data-copy">06 / EVIDENCE BOUNDARIES</p>
          <h2>What this case establishes</h2>
          <p>
            The research moved from a visible pricing pattern to a more demanding test of business performance. The slowdown narrows the interpretation: Chanel’s price architecture moved higher, but the slowdown still affected revenue and profitability. FY2025 brought partial group-revenue recovery, uneven regional performance, and an incomplete operating-profit recovery. The supported conclusion is coexistence, not causation.
          </p>
          <div class="report-boundaries">
            <div>
              <h3>Supported by public evidence</h3>
              <ul class="report-bullets">
                <li>Observed list-price endpoints in France and the United States, plus selected aligned French price histories.</li>
                <li>Chanel consolidated FY2023–FY2025 revenue and operating-profit movement, using filed-account inputs.</li>
                <li>Disclosed regional and channel bridges and an arithmetic reconciliation of the consolidated operating-profit gap.</li>
                <li>Different FY2024–FY2025 disclosed growth paths across Chanel, LVMH Fashion &amp; Leather Goods, Gucci, and Hermès, with their distinct definitions and reporting scopes.</li>
              </ul>
            </div>
            <div>
              <h3>Not established by this case</h3>
              <ul class="report-bullets">
                <li>Handbag-only revenue, units, margin, SKU profitability, or contribution to Chanel’s recovery.</li>
                <li>Customer conversion, willingness to pay, realized prices, volume and mix, migration, or brand substitution.</li>
                <li>Shopper nationality from regional revenue, or category sales from retail and wholesale channels.</li>
                <li>Whether price changes, marketing activity, or specific investments caused revenue, profit, cash flow, or desirability outcomes.</li>
              </ul>
            </div>
          </div>
          <p class="report-boundary">
            No buyer interviews or customer-choice instrument were used. The public-source analysis closes with these limits; it does not promise customer research without respondent access.
          </p>
        </section>

        <section id="sources" class="report-section report-section--sources">
          <p class="report-section__number data-copy">07 / SOURCES &amp; REPRODUCIBILITY</p>
          <h2>Sources and reproducibility</h2>
          <p>
            The links below lead to the underlying project, price evidence, slowdown diagnostics, calculation inputs, methodology, and company disclosures. Peer metrics retain the definitions used in the source reports.
          </p>
          <div class="report-sources">
            <div>
              <h3>Project and price evidence</h3>
              <a href={LUXURY_FLAGSHIP_SOURCES.readme} target="_blank" rel="noreferrer">Project repository ↗</a>
              <a href={LUXURY_FLAGSHIP_SOURCES.websiteHandoff} target="_blank" rel="noreferrer">Website handoff and claim map ↗</a>
              <a href={LUXURY_FLAGSHIP_SOURCES.report} target="_blank" rel="noreferrer">Price-architecture study ↗</a>
              <a href={LUXURY_FLAGSHIP_SOURCES.currentPanel} target="_blank" rel="noreferrer">Current France / U.S. price panel ↗</a>
              <a href={LUXURY_FLAGSHIP_SOURCES.methodology} target="_blank" rel="noreferrer">Methodology ↗</a>
              <a href={LUXURY_FLAGSHIP_SOURCES.validation} target="_blank" rel="noreferrer">Validation ↗</a>
            </div>
            <div>
              <h3>Slowdown analyses and data</h3>
              <a href={LUXURY_FLAGSHIP_SOURCES.slowdownPeerReview} target="_blank" rel="noreferrer">Peer comparison ↗</a>
              <a href={LUXURY_FLAGSHIP_SOURCES.slowdownRegionReview} target="_blank" rel="noreferrer">Regional revenue bridge ↗</a>
              <a href={LUXURY_FLAGSHIP_SOURCES.slowdownChannelReview} target="_blank" rel="noreferrer">Channel and product timing ↗</a>
              <a href={LUXURY_FLAGSHIP_SOURCES.slowdownProfitReview} target="_blank" rel="noreferrer">Operating-profit reconciliation ↗</a>
              <a href={LUXURY_FLAGSHIP_SOURCES.slowdownCustomerReview} target="_blank" rel="noreferrer">Customer and beauty evidence ↗</a>
              <a href={LUXURY_FLAGSHIP_SOURCES.slowdownFinancialInputs} target="_blank" rel="noreferrer">Filed-account inputs ↗</a>
            </div>
            <div>
              <h3>Company disclosures</h3>
              <a href="https://www.chanel.com/es/financial-results/" target="_blank" rel="noreferrer">Chanel financial results ↗</a>
              <a href="https://assets-finance.hermes.com/s3fs-public/node/pdf_file/2026-02/1770842737-hermes-2025-full-year-results-en.pdf" target="_blank" rel="noreferrer">Hermès 2025 full-year results ↗</a>
              <a href="https://www.lvmh.com/en/publications/solid-performance-in-a-disrupted-global-economic-environment/" target="_blank" rel="noreferrer">LVMH 2025 annual results ↗</a>
            </div>
          </div>
          <p class="report-final">
            Chanel’s price ladder moved higher. FY2025 group revenue partly recovered, but operating profit remained well below FY2023. Public evidence shows where the recovery appeared and how the profit gap reconciles; handbag-only demand and causal returns remain unmeasured.
          </p>
        </section>
      </article>
    </div>

    <footer class="report-footer">
      <span class="data-copy">GABRIEL CHEN / CHANEL PRICE LADDER THROUGH THE LUXURY SLOWDOWN</span>
      <span class="data-copy">UPDATED 2026-10-03 / PRICE SNAPSHOT 2026-08-15</span>
    </footer>
  </main>
</BaseLayout>

<script>
  const motionNodes = document.querySelectorAll<HTMLElement>('[data-report-motion]');
  const progress = document.querySelector<HTMLElement>('[data-report-progress]');
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.report-index a')];
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (reduceMotion || typeof IntersectionObserver !== 'function') {
    motionNodes.forEach((node) => {
      node.dataset.motionState = 'entered';
    });
  } else {
    motionNodes.forEach((node) => {
      node.dataset.motionState = 'pending';
    });

    const motionObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const node = entry.target as HTMLElement;
          node.dataset.motionState = 'entered';
          motionObserver.unobserve(node);
        });
      },
      { threshold: 0.12 },
    );

    motionNodes.forEach((node) => motionObserver.observe(node));
  }

  const updateProgress = () => {
    if (!progress) return;
    const scrollRange = document.documentElement.scrollHeight - window.innerHeight;
    const amount = scrollRange > 0 ? window.scrollY / scrollRange : 0;
    progress.style.transform = 'scaleX(' + amount + ')';
  };

  window.addEventListener('scroll', updateProgress, { passive: true });
  window.addEventListener('resize', updateProgress, { passive: true });
  updateProgress();

  document.querySelectorAll<HTMLElement>('[data-interactive-chart]').forEach((chart) => {
    const bars = [...chart.querySelectorAll<HTMLButtonElement>('[data-chart-bar]')];
    const clearSelection = () => {
      chart.removeAttribute('data-has-selection');
      bars.forEach((bar) => {
        bar.dataset.selected = 'false';
        bar.setAttribute('aria-pressed', 'false');
      });
    };

    bars.forEach((bar) => {
      bar.addEventListener('click', (event) => {
        event.stopPropagation();
        const wasSelected = bar.dataset.selected === 'true';
        bars.forEach((item) => {
          const isSelected = item === bar && !wasSelected;
          item.dataset.selected = String(isSelected);
          item.setAttribute('aria-pressed', String(isSelected));
        });

        if (wasSelected) chart.removeAttribute('data-has-selection');
        else chart.dataset.hasSelection = 'true';
      });
    });

    chart.addEventListener('click', clearSelection);
  });

  if (typeof IntersectionObserver === 'function') {
    const sectionObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const activeId = entry.target.id;
          links.forEach((link) => {
            const isActive = link.getAttribute('href') === '#' + activeId;
            link.dataset.active = String(isActive);
            if (isActive) link.setAttribute('aria-current', 'location');
            else link.removeAttribute('aria-current');
          });
        });
      },
      { rootMargin: '-18% 0px -65% 0px', threshold: 0 },
    );

    links.forEach((link) => {
      const id = link.getAttribute('href')?.slice(1);
      const section = id ? document.getElementById(id) : null;
      if (section) sectionObserver.observe(section);
    });
  }
</script>
