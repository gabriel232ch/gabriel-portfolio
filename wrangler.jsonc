{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gabriel-portfolio",
  "compatibility_date": "2026-08-31",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "pattern": "gabrielchen.me",
      "custom_domain": true
    }
  ]
}
